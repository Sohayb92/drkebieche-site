---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & prise de rendez-vous — Cabinet Dr Sohaïb Kebieche, Colombes"
  description="Cabinet du Dr Sohaïb Kebieche à Colombes (92700). Adresse, téléphone, prise de rendez-vous Doctolib, accès."
>

  <section class="container-wide pt-16 md:pt-24 pb-12 md:pb-16">
    <div class="max-w-3xl">
      <span class="eyebrow mb-5">Contact & rendez-vous</span>
      <h1 class="text-[34px] md:text-[48px] leading-[1.12] tracking-tight mb-6">
        Contact & rendez-vous <span class="text-teal-600">à Colombes.</span>
      </h1>
      <p class="text-[18px] text-ink-700 leading-[1.65]">
        Pour une première consultation, une urgence dentaire ou un suivi, le cabinet est ouvert du lundi au vendredi. La prise de rendez-vous se fait en ligne via Doctolib, par téléphone, ou en écrivant au cabinet via le <a href="#ecrire" class="text-teal-700 underline underline-offset-4">formulaire</a>.
      </p>
    </div>
  </section>


  <section class="container-wide pb-20">
    <div class="grid md:grid-cols-12 gap-10">

      <!-- Infos contact -->
      <div class="md:col-span-5 space-y-8">

        <div class="card">
          <div class="eyebrow mb-3">Adresse</div>
          <div class="text-[18px] font-display tracking-tight mb-1.5 leading-tight">
            31 rue Félix Faure<br>92700 Colombes
          </div>
          <a href="https://maps.google.com/?q=31+Rue+F%C3%A9lix+Faure+92700+Colombes" target="_blank" rel="noopener"
             class="text-[14px] text-teal-700 underline underline-offset-4 mt-3 inline-block">
            Itinéraire Google Maps →
          </a>
        </div>

        <div class="card">
          <div class="eyebrow mb-3">Téléphone</div>
          <a href="tel:+33142429469" class="block mt-1 text-[24px] md:text-[28px] font-display tracking-tight text-teal-600 tabular-nums whitespace-nowrap">
            01 42 42 94 69
          </a>
          <p class="text-[13px] text-ink-500 mt-2">
            Secrétariat joignable aux heures d’ouverture
          </p>
        </div>

        <div class="card">
          <div class="eyebrow mb-3">Écrire au cabinet</div>
          <p class="text-[14px] text-ink-700 leading-[1.6]">
            Pour les questions non urgentes, le <a href="#ecrire" class="text-teal-700 underline underline-offset-4">formulaire en bas de page</a> arrive directement dans la boîte du cabinet.
          </p>
        </div>

        <div class="card">
          <div class="eyebrow mb-3">Horaires</div>
          <ul class="text-[15px] space-y-1.5 tabular-nums">
            <li class="flex justify-between"><span>Lundi</span><span class="text-ink-700">9h–13h · 15h–18h30</span></li>
            <li class="flex justify-between"><span>Mardi</span><span class="text-ink-700">9h–13h · 15h–18h30</span></li>
            <li class="flex justify-between"><span>Mercredi</span><span class="text-ink-700">9h–13h · 15h–18h30</span></li>
            <li class="flex justify-between"><span>Jeudi</span><span class="text-ink-700">9h–13h · 15h–18h30</span></li>
            <li class="flex justify-between"><span>Vendredi</span><span class="text-ink-700">9h–13h · 15h–18h30</span></li>
            <li class="flex justify-between text-ink-400"><span>Samedi · Dimanche</span><span>Fermé</span></li>
          </ul>
        </div>

      </div>

      <!-- CTA Doctolib + accès -->
      <div class="md:col-span-7 space-y-6">

        <div class="rounded-2xl p-8 md:p-10" style="background: var(--color-teal-700); color: var(--color-cream-50)">
          <div class="eyebrow mb-4" style="color: var(--color-copper-300)">Prise de rendez-vous</div>
          <h2 class="text-[28px] md:text-[32px] font-display tracking-tight mb-4 text-cream-50">
            Réservez votre créneau en ligne
          </h2>
          <p class="text-[15px] opacity-85 mb-6 leading-[1.7]">
            Le cabinet utilise Doctolib pour la gestion des rendez-vous. Vous pouvez choisir le motif de consultation, voir les créneaux disponibles en temps réel et confirmer en quelques secondes.
          </p>
          <a href="https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes/booking/motives?specialityId=1&telehealth=false&placeId=practice-494254&source=profile" target="_blank" rel="noopener"
             class="btn"
             style="background: var(--color-cream-50); color: var(--color-teal-800)">
            Ouvrir Doctolib
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="card">
          <div class="eyebrow mb-3">Accès</div>
          <ul class="text-[14px] space-y-2.5 text-ink-700">
            <li class="flex gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.8" class="flex-shrink-0 mt-0.5"><path d="M5 17h14M5 17V7m14 10V7M5 7h14"/></svg>
              <span><strong>Train</strong> · Gare de Colombes (ligne J) et gare Les Vallées (ligne L) à proximité</span>
            </li>
            <li class="flex gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.8" class="flex-shrink-0 mt-0.5"><rect x="3" y="9" width="18" height="10" rx="2"/><path d="M3 9V7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2M7 19v2M17 19v2"/></svg>
              <span><strong>Bus</strong> · Arrêts « Les Vallées » et « Félix Faure » à proximité</span>
            </li>
            <li class="flex gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.8" class="flex-shrink-0 mt-0.5"><path d="M3 17a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5l-2-7H5l-2 7v5z"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>
              <span><strong>Voiture</strong> · Stationnement à proximité (rue Félix Faure)</span>
            </li>
            <li class="flex gap-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.8" class="flex-shrink-0 mt-0.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              <span><strong>Accessibilité</strong> · Ascenseur jusqu’au premier étage</span>
            </li>
          </ul>
          <p class="mt-4 text-[13.5px] text-ink-500 leading-[1.6]">
            Le cabinet accueille aussi les patients de La Garenne-Colombes, Bois-Colombes, Asnières-sur-Seine, Courbevoie et du quartier de La Défense.
          </p>
        </div>

      </div>

    </div>
  </section>


  <!-- Écrire au cabinet — formulaire -->
  <section id="ecrire" class="container-wide pb-20 scroll-mt-28">
    <div class="grid lg:grid-cols-12 gap-10">

      <div class="lg:col-span-5" data-reveal>
        <span class="eyebrow mb-4">Écrire au cabinet</span>
        <h2 class="text-[28px] md:text-[34px] leading-[1.15] tracking-tight mb-4" style="font-family: var(--font-display)">
          Une question avant de prendre rendez-vous ?
        </h2>
        <p class="text-[15px] text-ink-700 leading-[1.7] mb-5">
          Ce message arrive directement dans la boîte du cabinet. Nous vous répondons dès que possible, aux heures d’ouverture.
        </p>
        <div class="rounded-xl p-4 text-[13.5px] leading-[1.6] text-ink-700" style="background: var(--color-cream-200); border-left: 3px solid var(--color-copper-400)">
          <strong>En cas d’urgence, n’écrivez pas : appelez.</strong> <a href="tel:+33142429469" class="text-teal-700 underline underline-offset-4 whitespace-nowrap">01 42 42 94 69</a> aux heures d’ouverture — en dehors, le 15 pour toute urgence vitale.
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal data-reveal-delay="120">
        <form id="form-contact" class="card p-7 md:p-9 space-y-5" novalidate>
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label for="fc-nom" class="block text-[13px] font-semibold mb-1.5" style="color: var(--color-teal-800)">Votre nom</label>
              <input id="fc-nom" name="nom" type="text" required autocomplete="name"
                class="w-full rounded-lg px-4 py-3 text-[15px] transition-colors"
                style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)" />
            </div>
            <div>
              <label for="fc-contact" class="block text-[13px] font-semibold mb-1.5" style="color: var(--color-teal-800)">Email ou téléphone</label>
              <input id="fc-contact" name="contact" type="text" required autocomplete="email"
                class="w-full rounded-lg px-4 py-3 text-[15px] transition-colors"
                style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)" />
            </div>
          </div>
          <div>
            <label for="fc-message" class="block text-[13px] font-semibold mb-1.5" style="color: var(--color-teal-800)">Votre message</label>
            <textarea id="fc-message" name="message" rows="5" required
              class="w-full rounded-lg px-4 py-3 text-[15px] transition-colors resize-y"
              style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)"></textarea>
          </div>
          <!-- Honeypot anti-spam (invisible) -->
          <div class="hidden" aria-hidden="true">
            <label for="fc-site">Site web</label>
            <input id="fc-site" name="site" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="flex flex-col sm:flex-row sm:items-center gap-4 justify-between">
            <p class="text-[12px] text-ink-500 leading-[1.5] max-w-sm">
              Ces informations ne servent qu’à vous répondre. Évitez les détails médicaux sensibles — ils seront abordés en consultation.
            </p>
            <button type="submit" class="btn btn-primary flex-shrink-0">Envoyer le message</button>
          </div>
          <p id="fc-status" class="text-[14px] font-medium hidden" role="status"></p>
        </form>
      </div>

    </div>
  </section>

  <!-- Carte — façade 2 clics (aucune donnée envoyée à Google sans accord) -->
  <section class="container-wide pb-24">
    <div id="map-facade" class="rounded-2xl overflow-hidden relative" style="border: 1px solid var(--color-cream-300); background: var(--color-cream-100)">
      <div class="flex flex-col items-center justify-center text-center gap-4 px-6" style="min-height: 400px">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--color-copper-500)"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <div>
          <div class="text-[19px] font-medium mb-1" style="font-family: var(--font-display)">31 rue Félix Faure, 92700 Colombes</div>
          <p class="text-[13.5px] text-ink-500">Quartier des Vallées — gares de Colombes (ligne J) et Les Vallées (ligne L)</p>
        </div>
        <button id="map-load" class="btn btn-primary">Afficher la carte interactive</button>
        <p class="text-[11.5px] text-ink-500 max-w-md leading-[1.5]">
          La carte est fournie par Google Maps : en l’affichant, vous acceptez que votre adresse IP soit transmise à Google.
          <a href="https://maps.google.com/?q=31+Rue+F%C3%A9lix+Faure+92700+Colombes" target="_blank" rel="noopener" class="text-teal-700 underline underline-offset-2 whitespace-nowrap">Ouvrir l’itinéraire dans Google Maps →</a>
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    // Façade Google Maps « 2 clics » (CNIL) — l’iframe n’est injectée qu’au clic
    document.getElementById('map-load')?.addEventListener('click', () => {
      const facade = document.getElementById('map-facade');
      facade.innerHTML = '<iframe src="https://www.google.com/maps?q=31+rue+F%C3%A9lix+Faure,+92700+Colombes&output=embed&hl=fr" width="100%" height="400" style="border:0;display:block" allowfullscreen loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Plan d’accès — Cabinet Dr Sohaïb Kebieche, Colombes"></iframe>';
    });

    // Formulaire : envoi vers la fonction /api/contact ; repli mailto si indisponible
    const form = document.getElementById('form-contact');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = document.getElementById('fc-status');
      const nom = form.nom.value.trim();
      const contact = form.contact.value.trim();
      const message = form.message.value.trim();
      const show = (txt, ok) => {
        status.textContent = txt;
        status.classList.remove('hidden');
        status.style.color = ok ? 'var(--color-teal-700)' : 'var(--color-copper-600)';
      };
      if (!nom || !contact || !message) { show('Merci de remplir les trois champs.', false); return; }
      if (form.site.value) return; // honeypot
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true; btn.textContent = 'Envoi en cours…';
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ nom, contact, message, site: form.site.value }),
        });
        if (!res.ok) throw new Error('api');
        form.reset();
        show('Message envoyé — le cabinet vous répondra dès que possible.', true);
        btn.textContent = 'Message envoyé ✓';
      } catch {
        // Repli : ouvre le logiciel de mail du patient, message prérempli
        const body = encodeURIComponent(`Nom : ${nom}\nContact : ${contact}\n\n${message}`);
        window.location.href = `mailto:cabinetdentaire.lacabane@gmail.com?subject=${encodeURIComponent('Message via drkebieche.fr — ' + nom)}&body=${body}`;
        show("Votre logiciel de mail s’est ouvert avec le message prérempli — il ne reste qu’à l’envoyer.", true);
        btn.disabled = false; btn.textContent = 'Envoyer le message';
      }
    });
  </script>

</Layout>
