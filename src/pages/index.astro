---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import salleSoinsFenetre from '../assets/cabinet/salle-soins-fenetre.jpg';


// 4 familles médicales (architecture validée : pattern dentistes premium internationaux)
// Le détail des soins individuels est sur la page /soins, chaque section ancrée
// permet à Mélyia de pointer vers la bonne info via URL hash (#greffes-osseuses etc.)
const familles = [
  {
    slug: 'implantologie-chirurgie',
    titre: 'Implantologie & chirurgie',
    desc: "Pose d’implants, reconstruction osseuse pré-implantaire, chirurgie orale et avulsions complexes — savoir-faire issu d’une formation hospitalière.",
    icon: 'circle'
  },
  {
    slug: 'parodontologie',
    titre: 'Parodontologie',
    desc: "Soin médical des gencives et de l’os de soutien, traitement des récessions gingivales par techniques mini-invasives. D.U. de parodontologie avancée 2025.",
    icon: 'wave'
  },
  {
    slug: 'dentisterie-adhesive-protheses',
    titre: 'Dentisterie adhésive & prothèses',
    desc: "Restaurations céramiques (inlays, onlays, overlays) et composites sous digue, couronnes, bridges et prothèses implanto-portées en laboratoire français.",
    icon: 'diamond'
  },
  {
    slug: 'soins-quotidiens',
    titre: 'Soins du quotidien',
    desc: "Caries, dévitalisations, détartrage, urgences, blanchiment dentaire — toute la dentisterie courante au même endroit, dans la continuité des soins complexes.",
    icon: 'plus'
  },
];

function iconSvg(name: string) {
  const c = 'stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"';
  switch (name) {
    case 'circle':       return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>`;
    case 'arrow-down':   return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>`;
    case 'diamond':      return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><polygon points="12 3 21 12 12 21 3 12"/></svg>`;
    case 'circle-x':     return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><circle cx="12" cy="12" r="9"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>`;
    case 'triangle':     return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><polygon points="12 3 22 20 2 20"/></svg>`;
    case 'wave':         return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><path d="M3 12 Q 8 4 12 12 T 21 12"/></svg>`;
    case 'square':       return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><rect x="4" y="4" width="16" height="16" rx="1"/><rect x="9" y="9" width="6" height="6"/></svg>`;
    case 'plus':         return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
    default:             return '';
  }
}
---

<Layout
  title="Dr Sohaïb Kebieche — Chirurgien-dentiste à Colombes"
  description="Cabinet dentaire à Colombes (92700). Implantologie, parodontologie, dentisterie adhésive. Une dentisterie qui prend le temps de vous expliquer."
  alternates={[
    { hreflang: 'fr', href: '/' },
    { hreflang: 'en', href: '/en/' },
    { hreflang: 'x-default', href: '/' },
  ]}
>

  <!-- HERO : texte + mockup photo -->
  <section class="relative">
    <div class="container-wide pt-12 md:pt-20 pb-16 md:pb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Texte hero : accroche dominante (Newsreader), H1 SEO en strapline -->
        <div>
          <h1 class="eyebrow mb-6 fade-up-1" style="font-family: var(--font-body); font-size: 11.5px; letter-spacing: 0.16em; font-weight: 600; line-height: 1.6">
            Chirurgien-dentiste à Colombes — dentisterie adhésive & implantologie
          </h1>

          <p class="text-[38px] md:text-[48px] lg:text-[54px] leading-[1.08] tracking-tight mb-6 max-w-xl fade-up-2" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
            Une dentisterie qui prend le temps de vous expliquer.
          </p>

          <p class="text-[16px] md:text-[17px] text-ink-700 leading-[1.65] max-w-xl mb-7 fade-up-3">
            Conserver vos dents quand c’est possible, les remplacer mieux quand ce ne l’est plus. Implantologie, parodontologie et dentisterie adhésive, dans le quartier des Vallées.
          </p>

          <!-- Badges expertise above-the-fold, cliquables vers les pages liées -->
          <div class="flex flex-wrap gap-2 mb-8 fade-up-4">
            <a href="/soins/implantologie-chirurgie" class="badge-expertise hover:border-teal-300 transition-colors">D.U. Implantologie &amp; esthétique · Évry 2024</a>
            <a href="/soins/parodontologie" class="badge-expertise hover:border-teal-300 transition-colors">D.U. Parodontologie · Côte d’Azur 2025</a>
            <a href="/praticien" class="badge-expertise hover:border-teal-300 transition-colors hidden sm:inline-flex">Expérience hospitalière · chirurgie orale</a>
            <a href="/praticien" class="badge-expertise hover:border-teal-300 transition-colors hidden sm:inline-flex">Prix de thèse · Très Honorable</a>
          </div>

          <div class="flex flex-wrap gap-3 fade-up-5">
            <a href="https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes/booking/motives?specialityId=1&telehealth=false&placeId=practice-494254&source=profile" target="_blank" rel="noopener" class="btn btn-primary">
              Prendre rendez-vous
            </a>
            <a href="/praticien" class="btn btn-secondary">
              Découvrir le praticien
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </div>

          <div class="fade-up-5">
            <a href="https://g.page/r/CSAhN9X9DtepEBM" target="_blank" rel="noopener" class="inline-flex items-center gap-2 mt-6 text-[13.5px] font-medium hover:underline underline-offset-4" style="color: var(--color-copper-600)">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.26L21.5 9.27l-4.75 4.38L17.8 20.5 12 17.27 6.2 20.5l1.05-6.85L2.5 9.27l6.6-1.01L12 2z"/></svg>
              Les avis des patients sur Google →
            </a>
            <span class="block mt-3 text-[13px] text-ink-500">Le cabinet accueille de nouveaux patients · Conventionné, carte Vitale acceptée</span>
          </div>
        </div>

        <!-- Composition de marque (choix DA validé 2026-06-11 : le portrait reste
             l’exclusivité de /praticien ; une photo d’ambiance cabinet prendra
             cette place après le shooting) -->
        <div class="relative aspect-[4/3] md:aspect-[4/5] rounded-2xl overflow-hidden fade-up-3" style="border:1px solid var(--color-cream-300)">
          <Image src={salleSoinsFenetre} alt="Salle de soins lumineuse du cabinet dentaire du Dr Sohaïb Kebieche à Colombes, baignée de lumière par une fenêtre cintrée parisienne" widths={[448, 672, 896]} sizes="(min-width: 768px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
        </div>

      </div>
    </div>
  </section>


  <!-- L’APPROCHE — 3 piliers -->
  <section class="py-20 md:py-28" style="background: var(--color-cream-50)">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">L’approche</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight">
          Trois principes qui guident chaque consultation.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-10 md:gap-12">

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="0">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Conserver d’abord</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            La dentisterie moderne permet souvent de préserver une dent qu’on aurait sacrifiée hier. Onlays et overlays céramiques, soins endodontiques, maintenance parodontale : la priorité est toujours donnée à ce qui est <strong>votre</strong> tissu.
          </p>
        </div>

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="140">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Remplacer durablement</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            Lorsque la conservation n’est plus possible, l’implantologie permet de retrouver une fonction et une esthétique stables sur le long terme. <strong>Si nécessaire</strong>, elle s’appuie sur une chirurgie pré-implantaire (greffes osseuses, aménagements tissulaires) pour préparer le site.
          </p>
        </div>

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="280">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Expliquer toujours</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            Comprendre son traitement transforme l’expérience du patient. Chaque consultation se conclut par un plan de traitement écrit — et les pages de ce site l’accompagnent : schémas, conseils pré-opératoires, consignes post-opératoires.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- SOINS PROPOSÉS — 8 cards -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">Soins proposés</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-4">
          Une expertise centrée sur la conservation et la chirurgie.
        </h2>
        <p class="text-[15px] text-ink-500 leading-[1.7]">
          Omnipratique complète, avec une orientation marquée vers la chirurgie orale, l’implantologie et la parodontologie.
        </p>
      </div>

      <!-- 4 familles médicales (architecture boutique chic premium) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mb-10">
        {familles.map((f, idx) => (
          <a href={`/soins/${f.slug}`} class="card hover:border-teal-300 transition-colors group p-8 md:p-10" data-reveal data-reveal-delay={(idx * 100).toString()}>
            <div class="w-11 h-11 rounded-full flex items-center justify-center mb-6" style="background: var(--color-cream-200); color: var(--color-teal-800)">
              <Fragment set:html={iconSvg(f.icon)} />
            </div>
            <h3 class="text-[22px] md:text-[24px] font-medium mb-3" style="font-family: var(--font-display)">{f.titre}</h3>
            <p class="text-[15px] text-ink-500 leading-[1.7] mb-5">{f.desc}</p>
            <span class="text-[13px] font-medium inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
              Découvrir <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- CTA vers /soins (catalogue complet) -->
      <div class="text-center" data-reveal data-reveal-delay="500">
        <a href="/soins" class="btn btn-secondary">
          Découvrir tous les soins proposés
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- PARCOURS — section dark -->
  <section class="section-dark py-20 md:py-28">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">

        <div data-reveal data-reveal-delay="0">
          <span class="eyebrow mb-4">Parcours</span>
          <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight">
            Une formation continue pensée pour la chirurgie complexe et la conservation tissulaire.
          </h2>
        </div>

        <div data-reveal data-reveal-delay="160">
          <p class="text-[16px] leading-[1.75] opacity-90 mb-5">
            Diplômé de la Faculté de chirurgie dentaire Paris-Descartes, lauréat du prix de thèse mention Très Honorable et Félicitations du jury. Un parcours qui a associé pratique en cabinet et expérience hospitalière en chirurgie orale — et qui structure aujourd’hui une approche centrée sur les cas complexes : conservation, implantologie et parodontologie.
          </p>
          <p class="text-[14px] leading-[1.7] opacity-75 mb-7">
            Une formation continue régulière : D.U. d’implantologie et d’esthétique dentaire (Université d’Évry Paris-Saclay, 2024), D.U. de parodontologie avancée (Université Côte d’Azur, 2025), formation en chirurgie plastique parodontale (Tunneling Academy).
          </p>
          <a href="/praticien" class="inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-medium rounded transition-colors" style="border: 1px solid rgba(255,255,255,0.3); color: var(--color-cream-50);">
            Lire le parcours détaillé →
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- CONSEILS PATIENT — 3 cards + lien hub -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">Conseils patient</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-4">
          Vos fiches conseils, accessibles à tout moment.
        </h2>
        <p class="text-[15px] text-ink-500 leading-[1.7]">
          Après chaque consultation, un plan de traitement écrit vous est transmis, accompagné des liens vers ces fiches. Vous y retrouvez les consignes avant et après vos soins — chirurgie, parodontologie, blanchiment — et les bons gestes d’hygiène au quotidien, schémas à l’appui.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <a href="/conseils/avant" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="0">
          <h3 class="text-[18px] font-medium mb-3">Avant une intervention</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Bien se préparer à une extraction, un implant, une greffe ou une chirurgie : médicaments, repas, organisation.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>

        <a href="/conseils/apres-chirurgie" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="140">
          <h3 class="text-[18px] font-medium mb-3">Après une chirurgie</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Consignes post-opératoires détaillées : douleur, gonflement, alimentation, suites normales et signes d’alerte.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>

        <a href="/conseils/hygiene" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="280">
          <h3 class="text-[18px] font-medium mb-3">Hygiène au quotidien</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Brossage à 45° vers la gencive, brosse électrique, brossettes calibrées : tout ce qui se joue à la maison.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>
      </div>

      <div class="mt-8" data-reveal>
        <a href="/conseils" class="text-[14px] font-medium inline-flex items-center gap-1.5 hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
          Toutes les fiches conseils <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- VOTRE PREMIÈRE VISITE — parcours en 3 temps (pattern leaders internationaux) -->
  <section class="py-20 md:py-28">
    <div class="container-wide">
      <div class="max-w-2xl mb-12" data-reveal>
        <span class="eyebrow mb-4">Votre première visite</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight">
          Un déroulé simple, sans surprise.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5 mb-10">
        <div class="card" data-reveal data-reveal-delay="0">
          <div class="text-[40px] leading-none mb-4" style="font-family: var(--font-display); color: var(--color-copper-400)">1</div>
          <h3 class="text-[19px] font-medium mb-2.5">Examen complet</h3>
          <p class="text-[14px] text-ink-700 leading-[1.65]">Votre histoire, vos attentes, l’examen clinique — et les radiographies si nécessaire. Environ 40 minutes. Si tout va bien, le détartrage est souvent fait dans la même séance.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="120">
          <div class="text-[40px] leading-none mb-4" style="font-family: var(--font-display); color: var(--color-copper-400)">2</div>
          <h3 class="text-[19px] font-medium mb-2.5">Explications, schémas à l’appui</h3>
          <p class="text-[14px] text-ink-700 leading-[1.65]">Ce qui a été observé, ce qui est proposé et pourquoi — avec les pages de ce site en support, à relire chez vous.</p>
        </div>
        <div class="card" data-reveal data-reveal-delay="240">
          <div class="text-[40px] leading-none mb-4" style="font-family: var(--font-display); color: var(--color-copper-400)">3</div>
          <h3 class="text-[19px] font-medium mb-2.5">Devis remis avant tout soin</h3>
          <p class="text-[14px] text-ink-700 leading-[1.65]">Un plan de traitement écrit et chiffré. Rien n’est engagé sans votre accord — vous décidez à tête reposée.</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 text-[13.5px] text-ink-700" data-reveal>
        <a href="/conseils/premiere-consultation" class="font-medium inline-flex items-center gap-1.5" style="color: var(--color-teal-700)">
          Comment se passe la première consultation →
        </a>
        <span class="text-ink-500">Patient anxieux ? Dites-le simplement à la prise de rendez-vous : le déroulé s’adapte.</span>
      </div>
    </div>
  </section>


  <!-- LE CABINET + plateau technique -->
  <section class="py-20 md:py-28" style="background: var(--color-cream-50)">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div data-reveal data-reveal-delay="0">
          <span class="eyebrow mb-4">Le cabinet</span>
          <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-6">
            À Colombes, dans le quartier des Vallées.
          </h2>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-7">
            Le Cabinet Dentaire La Cabane est situé au cœur du quartier résidentiel des Vallées, à Colombes. Accès facile en train — gare de Colombes (ligne J) et gare Les Vallées (ligne L) à proximité —, en bus et en voiture. Le cabinet dispose d’un ascenseur jusqu’au premier étage.
          </p>

          <div class="text-[14px] text-ink-700 leading-[1.8] mb-7">
            <div class="font-semibold">31 rue Félix Faure, 92700 Colombes</div>
            <div>Téléphone : <a href="tel:+33142429469" style="color: var(--color-teal-700)">01 42 42 94 69</a></div>
            <div>Horaires d’ouverture : 9h00 – 13h30 · 15h00 – 19h00</div>
          </div>

          <a href="/cabinet" class="btn btn-secondary">
            Plan d’accès et informations →
          </a>
        </div>

        <!-- Plateau technique (remplace le placeholder photo en attendant le shooting) -->
        <div data-reveal data-reveal-delay="160">
          <div class="rounded-2xl p-7 md:p-9 section-dark">
            <div class="eyebrow mb-6">Le plateau technique</div>
            <ul class="space-y-5">
              <li class="flex gap-4 items-start">
                <span class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.08)">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="color: var(--color-copper-300)"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4"/><line x1="12" y1="3" x2="12" y2="7"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                </span>
                <div>
                  <div class="text-[15.5px] font-medium mb-0.5">Imagerie 3D (cone beam)</div>
                  <p class="text-[13.5px] opacity-75 leading-[1.6]">Implants et chirurgies complexes planifiés en 3D avant le geste — jamais pendant.</p>
                </div>
              </li>
              <li class="flex gap-4 items-start">
                <span class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.08)">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="color: var(--color-copper-300)"><path d="M15 5l4 4L8 20l-5 1 1-5L15 5z"/><path d="M13 7l4 4"/></svg>
                </span>
                <div>
                  <div class="text-[15.5px] font-medium mb-0.5">Empreinte optique</div>
                  <p class="text-[13.5px] opacity-75 leading-[1.6]">Des empreintes numériques à la caméra — sans pâte, plus confortables, plus précises.</p>
                </div>
              </li>
              <li class="flex gap-4 items-start">
                <span class="flex-shrink-0 w-9 h-9 rounded-full flex items-center justify-center" style="background: rgba(255,255,255,0.08)">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="color: var(--color-copper-300)"><rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="12" cy="12" r="4"/></svg>
                </span>
                <div>
                  <div class="text-[15.5px] font-medium mb-0.5">Collages sous digue</div>
                  <p class="text-[13.5px] opacity-75 leading-[1.6]">Un champ opératoire étanche, systématique : la condition d’une dentisterie adhésive durable.</p>
                </div>
              </li>
            </ul>
            <a href="/cabinet" class="inline-flex items-center gap-2 mt-7 text-[13.5px] font-medium" style="color: var(--color-copper-300)">
