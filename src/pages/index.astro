---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Dr Sohaïb Kebieche — Chirurgien-dentiste à Colombes"
  description="Cabinet dentaire à Colombes (92700). Implantologie, parodontologie, dentisterie adhésive moderne. Une dentisterie d'excellence, expliquée, sans rush."
>

  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="container-wide pt-16 md:pt-28 pb-20 md:pb-32">

      <div class="max-w-3xl">
        <span class="eyebrow mb-6">Cabinet Dr Sohaïb Kebieche · Colombes (92)</span>

        <h1 class="text-[42px] md:text-[64px] lg:text-[72px] leading-[1.05] tracking-tight mb-7 fade-up">
          Une dentisterie d'excellence,<br>
          <span class="italic text-sage-600">expliquée.</span>
        </h1>

        <p class="text-[18px] md:text-[20px] text-ink-700 leading-[1.6] max-w-2xl mb-10">
          Implantologie, parodontologie et dentisterie adhésive moderne, à Colombes.
          Un cabinet qui prend le temps de comprendre votre histoire dentaire,
          de l'expliquer, et d'y répondre sans rush.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="https://www.doctolib.fr" target="_blank" rel="noopener" class="btn btn-primary">
            Prendre rendez-vous
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
          <a href="/cabinet" class="btn btn-secondary">Découvrir le cabinet</a>
        </div>

      </div>
    </div>

    <!-- Décor subtil : ligne copper en bas du hero -->
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-24 h-px" style="background: var(--color-copper-400)"></div>
  </section>


  <!-- BANDEAU CONFIANCE -->
  <section class="border-y border-cream-300" style="background: var(--color-cream-50)">
    <div class="container-wide py-10 md:py-12">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 gap-x-6 text-center md:text-left">

        <div>
          <div class="text-[14px] font-medium text-sage-700 mb-1.5">Université Paris-Descartes</div>
          <div class="text-[12px] text-ink-500">Diplôme d'État de docteur</div>
        </div>

        <div>
          <div class="text-[14px] font-medium text-sage-700 mb-1.5">D.U. Implantologie 2024</div>
          <div class="text-[12px] text-ink-500">Université d'Évry-Val-d'Essonne</div>
        </div>

        <div>
          <div class="text-[14px] font-medium text-sage-700 mb-1.5">D.U. Parodontologie 2025</div>
          <div class="text-[12px] text-ink-500">Université Côte d'Azur</div>
        </div>

        <div>
          <div class="text-[14px] font-medium text-sage-700 mb-1.5">Praticien hospitalier</div>
          <div class="text-[12px] text-ink-500">CASH Nanterre · APHP Louis-Mourier</div>
        </div>

      </div>
    </div>
  </section>


  <!-- 3 PILIERS DE SOIN -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-2xl mb-14 md:mb-18">
        <span class="eyebrow mb-4">Domaines d'expertise</span>
        <h2 class="text-[36px] md:text-[48px] leading-[1.1] tracking-tight">
          Une dentisterie complète,<br>
          <span class="italic text-sage-600">guidée par la précision.</span>
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">

        <!-- Implantologie -->
        <a href="/soins/implantologie" class="group card hover:shadow-xl hover:-translate-y-1 transition-all duration-500 cursor-pointer" style="--ease-soft: cubic-bezier(0.32, 0.72, 0, 1)">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6" style="background: var(--color-sage-100)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.6"><path d="M12 2C8 2 5 5 5 9c0 5 3 8 3 12h8c0-4 3-7 3-12 0-4-3-7-7-7z"/><path d="M9 22h6"/></svg>
          </div>
          <h3 class="text-[24px] font-display mb-3 tracking-tight">Implantologie</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5">
            Pose d'implants, comblements osseux et greffes — issus d'une formation hospitalière et d'un D.U. d'implantologie 2024.
          </p>
          <span class="text-[14px] text-sage-700 font-medium group-hover:underline underline-offset-4">
            Découvrir →
          </span>
        </a>

        <!-- Parodontologie -->
        <a href="/soins/parodontologie" class="group card hover:shadow-xl hover:-translate-y-1 transition-all duration-500 cursor-pointer">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6" style="background: var(--color-sage-100)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.6"><path d="M3 12c2-4 6-7 9-7s7 3 9 7c-2 4-6 7-9 7s-7-3-9-7z"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="text-[24px] font-display mb-3 tracking-tight">Parodontologie</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5">
            Traitement des gencives et de l'os de soutien — bilan, assainissement, maintenance. D.U. de parodontologie avancée 2025.
          </p>
          <span class="text-[14px] text-sage-700 font-medium group-hover:underline underline-offset-4">
            Découvrir →
          </span>
        </a>

        <!-- Dentisterie adhésive -->
        <a href="/soins/dentisterie-adhesive" class="group card hover:shadow-xl hover:-translate-y-1 transition-all duration-500 cursor-pointer">
          <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-6" style="background: var(--color-sage-100)">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#4a6557" stroke-width="1.6"><path d="M12 2v20M2 12h20"/><circle cx="12" cy="12" r="9"/></svg>
          </div>
          <h3 class="text-[24px] font-display mb-3 tracking-tight">Dentisterie adhésive</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5">
            Inlays, onlays et overlays en céramique, composites stratifiés sous digue — la reconstruction respectueuse, mini-invasive et durable.
          </p>
          <span class="text-[14px] text-sage-700 font-medium group-hover:underline underline-offset-4">
            Découvrir →
          </span>
        </a>

      </div>

      <div class="text-center mt-12">
        <a href="/soins" class="btn btn-ghost">Tous les soins →</a>
      </div>

    </div>
  </section>


  <!-- POURQUOI MON CABINET -->
  <section class="py-20 md:py-28" style="background: var(--color-sage-50)">
    <div class="container-wide">

      <div class="grid md:grid-cols-12 gap-10 md:gap-16">

        <div class="md:col-span-5">
          <span class="eyebrow mb-4">L'approche du cabinet</span>
          <h2 class="text-[36px] md:text-[44px] leading-[1.1] tracking-tight mb-6">
            Pas à la chaîne.<br>
            <span class="italic text-sage-600">À votre rythme.</span>
          </h2>
          <p class="text-[16px] text-ink-700 leading-[1.7] mb-6">
            La précision en dentisterie demande du temps — pour examiner,
            pour expliquer, pour ajuster. Mon cabinet est organisé autour
            de ce principe simple : un patient à la fois, sans rotation
            de salles, sans pression sur l'agenda.
          </p>
          <a href="/cabinet" class="btn btn-secondary">Mon parcours →</a>
        </div>

        <div class="md:col-span-7 grid sm:grid-cols-2 gap-5">

          <div class="card">
            <div class="text-[36px] font-display text-sage-600 mb-2 tabular-nums">01</div>
            <h3 class="text-[18px] font-medium mb-2 tracking-tight">Expertise hospitalière</h3>
            <p class="text-[14px] text-ink-700 leading-[1.65]">
              Praticien attaché en chirurgie orale au CASH Nanterre. Formé à l'APHP Louis-Mourier et au GHT NOVO Pontoise.
            </p>
          </div>

          <div class="card">
            <div class="text-[36px] font-display text-sage-600 mb-2 tabular-nums">02</div>
            <h3 class="text-[18px] font-medium mb-2 tracking-tight">Techniques récentes</h3>
            <p class="text-[14px] text-ink-700 leading-[1.65]">
              Dentisterie adhésive sous digue, inlays/onlays céramique, implantologie guidée. Mes D.U. de 2024 et 2025 intègrent les techniques d'aujourd'hui.
            </p>
          </div>

          <div class="card">
            <div class="text-[36px] font-display text-sage-600 mb-2 tabular-nums">03</div>
            <h3 class="text-[18px] font-medium mb-2 tracking-tight">Plan de soin expliqué</h3>
            <p class="text-[14px] text-ink-700 leading-[1.65]">
              Chaque devis est accompagné d'un mail détaillé : ce qui est prévu, pourquoi, dans quel ordre. Vous décidez en comprenant.
            </p>
          </div>

          <div class="card">
            <div class="text-[36px] font-display text-sage-600 mb-2 tabular-nums">04</div>
            <h3 class="text-[18px] font-medium mb-2 tracking-tight">Suivi sérieux</h3>
            <p class="text-[14px] text-ink-700 leading-[1.65]">
              Maintenance parodontale, contrôles implantaires, rappels personnalisés. La relation continue après le soin.
            </p>
          </div>

        </div>

      </div>

    </div>
  </section>


  <!-- TÉMOIGNAGES (placeholder) -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-3xl mx-auto text-center mb-14">
        <span class="eyebrow mb-4">Ce que disent les patients</span>
        <h2 class="text-[36px] md:text-[44px] leading-[1.1] tracking-tight">
          <span class="text-sage-600">5,0</span> sur Doctolib
        </h2>
        <p class="text-[15px] text-ink-500 mt-4">Sur la base de 20 avis vérifiés</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">

        <blockquote class="card">
          <div class="flex gap-0.5 mb-4 text-copper-400">
            ★★★★★
          </div>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5 italic">
            « Très bon dentiste, très professionnel. Il prend le temps d'expliquer et le travail est de grande qualité. »
          </p>
          <div class="text-[12px] text-ink-500 uppercase tracking-wider">Patient vérifié</div>
        </blockquote>

        <blockquote class="card">
          <div class="flex gap-0.5 mb-4 text-copper-400">
            ★★★★★
          </div>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5 italic">
            « Cabinet calme, soin minutieux. On sent que tout est pensé pour la durabilité. Je recommande sans hésiter. »
          </p>
          <div class="text-[12px] text-ink-500 uppercase tracking-wider">Patient vérifié</div>
        </blockquote>

        <blockquote class="card">
          <div class="flex gap-0.5 mb-4 text-copper-400">
            ★★★★★
          </div>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-5 italic">
            « Approche pédagogique, devis clairs, suivi impeccable. Une vraie différence vs mes précédents dentistes. »
          </p>
          <div class="text-[12px] text-ink-500 uppercase tracking-wider">Patient vérifié</div>
        </blockquote>

      </div>

      <div class="text-center mt-10">
        <a href="https://g.co/kgs/" target="_blank" rel="noopener" class="text-[14px] text-sage-700 underline underline-offset-4">
          Voir tous les avis sur Google →
        </a>
      </div>

    </div>
  </section>


  <!-- CTA FINAL -->
  <section class="pb-24 md:pb-32">
    <div class="container-wide">
      <div class="rounded-3xl px-8 md:px-16 py-16 md:py-20 text-center" style="background: var(--color-sage-700); color: var(--color-cream-50)">
        <span class="inline-block text-[11px] font-medium uppercase tracking-[0.18em] mb-5" style="color: var(--color-copper-300)">
          Prochaine étape
        </span>
        <h2 class="text-[36px] md:text-[48px] font-display leading-[1.1] tracking-tight mb-5 text-cream-50">
          Prenons le temps<br>
          <span class="italic" style="color: var(--color-copper-300)">d'en parler.</span>
        </h2>
        <p class="text-[16px] md:text-[18px] opacity-85 max-w-xl mx-auto mb-9">
          Première consultation : examen, radiographies si nécessaire, et plan de soin expliqué. Sans engagement.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="https://www.doctolib.fr" target="_blank" rel="noopener"
             class="btn"
             style="background: var(--color-cream-50); color: var(--color-sage-800)">
            Prendre rendez-vous
          </a>
          <a href="tel:+33142429469"
             class="btn"
             style="background: transparent; color: var(--color-cream-50); border: 1px solid rgba(251,250,246,0.3)">
            01 42 42 94 69
          </a>
        </div>
      </div>
    </div>
  </section>

</Layout>
