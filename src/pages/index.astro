---
import Layout from '../layouts/Layout.astro';

// 4 familles médicales (architecture validée : pattern dentistes premium internationaux)
// Le détail des soins individuels est sur la page /soins, chaque section ancrée
// permet à Mélyia de pointer vers la bonne info via URL hash (#greffes-osseuses etc.)
const familles = [
  {
    slug: 'implantologie-chirurgie',
    titre: 'Implantologie & chirurgie',
    desc: "Pose d'implants, reconstruction osseuse pré-implantaire, chirurgie orale et avulsions complexes — savoir-faire issu d'une formation hospitalière.",
    icon: 'circle'
  },
  {
    slug: 'parodontologie',
    titre: 'Parodontologie',
    desc: "Soin médical des gencives et de l'os de soutien, traitement des récessions gingivales par techniques mini-invasives. D.U. de parodontologie avancée 2025.",
    icon: 'wave'
  },
  {
    slug: 'dentisterie-adhesive-protheses',
    titre: 'Dentisterie adhésive & prothèses',
    desc: "Restaurations céramiques (inlays, onlays, overlays) et composites sous digue, couronnes, bridges et prothèses implanto-portées en laboratoire français.",
    icon: 'diamond'
  },
  {
    slug: 'soins-quotidiens',
    titre: 'Soins du quotidien',
    desc: "Caries, détartrage, urgences, suivi régulier, blanchiment dentaire — toute la dentisterie courante au même endroit, dans la continuité des soins complexes.",
    icon: 'plus'
  },
];

function iconSvg(name: string) {
  const c = 'stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"';
  switch (name) {
    case 'circle':       return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>`;
    case 'arrow-down':   return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><line x1="12" y1="5" x2="12" y2="19"/><polyline points="6 13 12 19 18 13"/></svg>`;
    case 'diamond':      return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><polygon points="12 3 21 12 12 21 3 12"/></svg>`;
    case 'circle-x':     return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><circle cx="12" cy="12" r="9"/><line x1="9" y1="9" x2="15" y2="15"/><line x1="15" y1="9" x2="9" y2="15"/></svg>`;
    case 'triangle':     return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><polygon points="12 3 22 20 2 20"/></svg>`;
    case 'wave':         return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><path d="M3 12 Q 8 4 12 12 T 21 12"/></svg>`;
    case 'square':       return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><rect x="4" y="4" width="16" height="16" rx="1"/><rect x="9" y="9" width="6" height="6"/></svg>`;
    case 'plus':         return `<svg width="20" height="20" viewBox="0 0 24 24" ${c}><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>`;
    default:             return '';
  }
}
---

<Layout
  title="Dr Sohaïb Kebieche — Chirurgien-dentiste à Colombes"
  description="Cabinet dentaire à Colombes (92700). Implantologie, parodontologie, dentisterie adhésive. Une dentisterie qui prend le temps de vous expliquer."
>

  <!-- HERO : texte + mockup photo -->
  <section class="relative">
    <div class="container-wide pt-12 md:pt-20 pb-16 md:pb-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <!-- Texte hero : H1 SEO + accroche tonale en sous-titre (reco agent) -->
        <div>
          <span class="eyebrow mb-7">Chirurgien-dentiste · Colombes (92)</span>

          <h1 class="text-[28px] md:text-[34px] lg:text-[38px] leading-[1.2] tracking-tight mb-5 fade-up" style="color: var(--color-teal-800)">
            Dentisterie adhésive et implantologie<br>
            <span class="text-ink-700">— Dr Sohaïb Kebieche, Colombes</span>
          </h1>

          <p class="text-[24px] md:text-[28px] lg:text-[32px] leading-[1.2] mb-6 max-w-xl" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
            Une dentisterie qui prend le temps de vous expliquer.
          </p>

          <p class="text-[16px] md:text-[17px] text-ink-700 leading-[1.65] max-w-xl mb-7">
            Conserver vos dents quand c'est possible, les remplacer mieux quand ce ne l'est plus. Implantologie, parodontologie et dentisterie adhésive, à Colombes — quartier des Vallées.
          </p>

          <!-- Badges expertise above-the-fold -->
          <div class="flex flex-wrap gap-2 mb-8">
            <span class="badge-expertise">D.U. Implantologie · Évry Paris-Saclay 2024</span>
            <span class="badge-expertise">D.U. Parodontologie · Côte d'Azur 2025</span>
            <span class="badge-expertise">Ancien praticien attaché APHP · chirurgie orale</span>
            <span class="badge-expertise">Prix de thèse · Très Honorable</span>
          </div>

          <div class="flex flex-wrap gap-3">
            <a href="https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes/booking/motives?specialityId=1&telehealth=false&placeId=practice-494254&source=profile" target="_blank" rel="noopener" class="btn btn-primary">
              Prendre rendez-vous
            </a>
            <a href="/praticien" class="btn btn-secondary">
              Découvrir le praticien
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Mockup photo praticien -->
        <div class="relative aspect-[4/5] rounded-2xl overflow-hidden" style="background: var(--color-copper-400)">
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-[14px] italic" style="color: rgba(255,255,255,0.65); font-family: var(--font-display)">Portrait clinique</span>
          </div>
          <div class="absolute bottom-4 left-4 text-[11px] px-2.5 py-1 rounded" style="background: var(--color-teal-800); color: var(--color-cream-50)">
            Photographie à venir
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- L'APPROCHE — 3 piliers -->
  <section class="py-20 md:py-28" style="background: var(--color-cream-50)">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">L'approche</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight">
          Trois principes qui guident chaque consultation.
        </h2>
      </div>

      <div class="grid md:grid-cols-3 gap-10 md:gap-12">

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="0">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Conserver d'abord</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            La dentisterie moderne permet souvent de préserver une dent qu'on aurait sacrifiée hier. Onlays et overlays céramiques, soins endodontiques, maintenance parodontale : la priorité est toujours donnée à ce qui est <em>votre</em> tissu.
          </p>
        </div>

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="140">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Remplacer durablement</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            Lorsque la conservation n'est plus possible, l'implantologie permet de retrouver une fonction et une esthétique stables sur le long terme. <em>Si nécessaire</em>, elle s'appuie sur une chirurgie pré-implantaire (greffes osseuses, aménagements tissulaires) pour préparer le site.
          </p>
        </div>

        <div class="border-l pl-6" style="border-color: var(--color-copper-400)" data-reveal data-reveal-delay="280">
          <h3 class="text-[22px] md:text-[24px] font-medium mb-4">Expliquer toujours</h3>
          <p class="text-[15px] text-ink-700 leading-[1.7]">
            Comprendre son traitement transforme l'expérience du patient. Chaque consultation se conclut par un plan de traitement écrit et un dossier de soins personnalisé que vous retrouvez sur ce site — schémas, conseils pré-opératoires, consignes post-opératoires.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- SOINS PROPOSÉS — 8 cards -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">Soins proposés</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-4">
          Une expertise centrée sur la conservation et la chirurgie.
        </h2>
        <p class="text-[15px] text-ink-500 leading-[1.7]">
          Omnipratique complète, avec une orientation marquée vers la chirurgie orale, l'implantologie et la parodontologie.
        </p>
      </div>

      <!-- 4 familles médicales (architecture boutique chic premium) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 mb-10">
        {familles.map((f, idx) => (
          <a href={`/soins/${f.slug}`} class="card hover:border-teal-300 transition-colors group p-8 md:p-10" data-reveal data-reveal-delay={(idx * 100).toString()}>
            <div class="w-11 h-11 rounded-full flex items-center justify-center mb-6" style="background: var(--color-cream-200); color: var(--color-teal-800)">
              <Fragment set:html={iconSvg(f.icon)} />
            </div>
            <h3 class="text-[22px] md:text-[24px] font-medium mb-3" style="font-family: var(--font-display)">{f.titre}</h3>
            <p class="text-[15px] text-ink-500 leading-[1.7] mb-5">{f.desc}</p>
            <span class="text-[13px] font-medium inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
              Découvrir <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>

      <!-- CTA vers /soins (catalogue complet) -->
      <div class="text-center" data-reveal data-reveal-delay="500">
        <a href="/soins" class="btn btn-secondary">
          Découvrir tous les soins proposés
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </section>


  <!-- PARCOURS — section dark -->
  <section class="section-dark py-20 md:py-28">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20">

        <div data-reveal data-reveal-delay="0">
          <span class="eyebrow mb-4">Parcours</span>
          <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight">
            Une formation continue pensée pour la chirurgie complexe et la conservation tissulaire.
          </h2>
        </div>

        <div data-reveal data-reveal-delay="160">
          <p class="text-[16px] leading-[1.75] opacity-90 mb-5">
            Diplômé de la Faculté de chirurgie dentaire de Paris, lauréat du prix de thèse mention Très Honorable et Félicitations du jury. Un parcours qui associe pratique en cabinet et expérience hospitalière en chirurgie orale — et structure aujourd'hui une approche centrée sur les cas complexes : conservation, implantologie et parodontologie.
          </p>
          <p class="text-[14px] leading-[1.7] opacity-75 mb-7">
            Une formation continue régulière : D.U. d'Implantologie (Université d'Évry Paris-Saclay, 2024), D.U. de Parodontologie avancée (Université Côte d'Azur, 2025), formation en chirurgie plastique parodontale (Tunneling Academy).
          </p>
          <a href="/praticien" class="inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-medium rounded transition-colors" style="border: 1px solid rgba(255,255,255,0.3); color: var(--color-cream-50);">
            Lire le parcours détaillé →
          </a>
        </div>

      </div>
    </div>
  </section>


  <!-- COMPRENDRE VOS SOINS — 3 cards -->
  <section class="py-20 md:py-28">
    <div class="container-wide">

      <div class="max-w-2xl mb-14" data-reveal>
        <span class="eyebrow mb-4">Comprendre vos soins</span>
        <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-4">
          Un dossier patient, accessible à tout moment.
        </h2>
        <p class="text-[15px] text-ink-500 leading-[1.7]">
          Après chaque consultation, un plan de traitement écrit vous est transmis, accompagné des liens vers cette section du site. Vous y retrouvez, soin par soin, les explications, les schémas, les consignes pré et post-opératoires, et les conseils d'hygiène quotidienne.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        <a href="/comprendre/avant" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="0">
          <h3 class="text-[18px] font-medium mb-3">Avant l'intervention</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Conseils pré-opératoires pour les extractions, implants, greffes osseuses et chirurgies parodontales.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>

        <a href="/comprendre/apres" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="140">
          <h3 class="text-[18px] font-medium mb-3">Après l'intervention</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Consignes post-opératoires détaillées : douleur, gonflement, alimentation, hygiène, suites normales.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>

        <a href="/comprendre/hygiene" class="card hover:border-teal-300 transition-colors" data-reveal data-reveal-delay="280">
          <h3 class="text-[18px] font-medium mb-3">Hygiène au quotidien</h3>
          <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">Brossage, brossettes interdentaires, bains de bouche, alimentation : tout ce qui se joue à la maison.</p>
          <span class="text-[13px] font-medium" style="color: var(--color-teal-700)">Consulter →</span>
        </a>
      </div>

    </div>
  </section>


  <!-- LE CABINET -->
  <section class="py-20 md:py-28" style="background: var(--color-cream-50)">
    <div class="container-wide">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div data-reveal data-reveal-delay="0">
          <span class="eyebrow mb-4">Le cabinet</span>
          <h2 class="text-[32px] md:text-[42px] leading-[1.12] tracking-tight mb-6">
            À Colombes, dans le quartier des Vallées.
          </h2>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-7">
            Le Cabinet Dentaire La Cabane est situé au cœur du quartier résidentiel des Vallées, à Colombes. Accès facile en train — gare de Colombes (ligne J) et gare Les Vallées (ligne L) à proximité —, en bus et en voiture. Le cabinet dispose d'un ascenseur jusqu'au premier étage.
          </p>

          <div class="text-[14px] text-ink-700 leading-[1.8] mb-7">
            <div class="font-semibold">31 Rue Felix Faure, 92700 Colombes</div>
            <div>Téléphone : <a href="tel:+33142429469" style="color: var(--color-teal-700)">01 42 42 94 69</a></div>
            <div>Horaires d'ouverture : 9h00 – 13h00 · 15h00 – 18h30</div>
          </div>

          <a href="/cabinet" class="btn btn-secondary">
            Plan d'accès et informations →
          </a>
        </div>

        <!-- Mockup photo cabinet -->
        <div class="relative aspect-[4/3] rounded-2xl overflow-hidden section-dark" data-reveal data-reveal-delay="160">
          <div class="absolute inset-0 flex items-center justify-center">
            <span class="text-[14px] italic opacity-65" style="font-family: var(--font-display)">Photographie du cabinet</span>
          </div>
          <div class="absolute bottom-4 left-4 text-[11px] px-2.5 py-1 rounded" style="background: var(--color-teal-700); color: var(--color-cream-50)">
            Photographie à venir
          </div>
        </div>

      </div>
    </div>
  </section>

</Layout>
