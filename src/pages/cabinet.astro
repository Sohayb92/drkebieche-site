---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import salleSoinsFenetre from '../assets/cabinet/salle-soins-fenetre.jpg';
import salleSoinsBleue from '../assets/cabinet/salle-soins-bleue.jpg';
import salleAttente from '../assets/cabinet/salle-attente.jpg';
import sterilisation from '../assets/cabinet/sterilisation.jpg';
import salleRadio from '../assets/cabinet/salle-radio.jpg';
---

<Layout
  title="Le cabinet — Cabinet Dentaire La Cabane, Colombes (quartier des Vallées)"
  description="Le cabinet dentaire du Dr Kebieche à Colombes : 31 rue Félix Faure, quartier des Vallées. Accès en train (lignes J et L), ascenseur, plateau technique moderne."
>

  <!-- HERO -->
  <section class="container-wide pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">Le cabinet</span>
      <h1 class="text-[28px] md:text-[36px] leading-[1.2] tracking-tight mb-5" style="color: var(--color-teal-800)">
        Cabinet Dentaire La Cabane<br>
        <span class="text-ink-700">— Colombes, quartier des Vallées</span>
      </h1>
      <p class="text-[22px] md:text-[26px] leading-[1.25] mb-6" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
        Un cabinet de quartier, un plateau technique de chirurgie.
      </p>
      <p class="text-[16px] text-ink-700 leading-[1.7]">
        Au cœur du quartier résidentiel des Vallées, le cabinet associe la proximité d’un cabinet de ville et l’équipement nécessaire aux soins complexes — imagerie 3D, collages sous digue, empreintes numériques sans pâte.
      </p>
    </div>
  </section>


  <!-- PHOTO + INFOS PRATIQUES -->
  <section class="container-wide pb-16 md:pb-24">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start">

      <!-- Photo cabinet : salle d'attente (cliquable → lightbox) -->
      <button type="button" class="gallery-item group relative block w-full p-0 aspect-[4/3] rounded-2xl overflow-hidden cursor-zoom-in" style="border:1px solid var(--color-cream-300)" data-reveal data-full={salleAttente.src} data-caption="Salle d'attente">
        <Image src={salleAttente} alt="Salle d'attente chaleureuse du Cabinet Dentaire La Cabane à Colombes, quartier des Vallées" widths={[480, 768, 1190]} sizes="(min-width: 1024px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
      </button>

      <!-- Infos -->
      <div class="space-y-6" data-reveal data-reveal-delay="140">

        <div class="card !p-6">
          <div class="eyebrow mb-3">Adresse</div>
          <div class="text-[17px] font-medium mb-1" style="font-family: var(--font-display)">31 Rue Félix Faure, 92700 Colombes</div>
          <div class="text-[14px] text-ink-500">Premier étage — ascenseur</div>
        </div>

        <div class="card !p-6">
          <div class="eyebrow mb-3">Horaires</div>
          <div class="text-[15px] text-ink-700">Lundi – vendredi · 9h–13h30 et 15h–19h</div>
        </div>

        <div class="card !p-6">
          <div class="eyebrow mb-3">Accès</div>
          <ul class="text-[14px] space-y-1.5 text-ink-700">
            <li><strong>Train</strong> · Gare de Colombes (ligne J) et gare Les Vallées (ligne L) à proximité</li>
            <li><strong>Bus</strong> · Arrêts « Les Vallées » et « Félix Faure »</li>
            <li><strong>Voiture</strong> · Stationnement à proximité</li>
          </ul>
          <p class="mt-4 text-[13.5px] text-ink-500 leading-[1.6]">
            À quelques minutes de La Garenne-Colombes, Bois-Colombes, Asnières-sur-Seine et Courbevoie — et à un quart d’heure de La Défense.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="/contact" class="btn btn-secondary">Contact & plan d’accès</a>
          <a href="/praticien" class="btn btn-ghost">Le praticien →</a>
        </div>

      </div>
    </div>
  </section>


  <!-- PLATEAU TECHNIQUE -->
  <section class="py-16 md:py-24" style="background: var(--color-cream-50)">
    <div class="container-wide">
      <div class="max-w-2xl mb-12" data-reveal>
        <span class="eyebrow mb-4">Le plateau technique</span>
        <h2 class="text-[30px] md:text-[40px] leading-[1.12] tracking-tight">
          L’équipement au service de la précision.
        </h2>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5" data-reveal data-reveal-delay="120">
        <div class="card">
          <h3 class="text-[18px] font-medium mb-2.5" style="font-family: var(--font-display)">Imagerie 3D</h3>
          <p class="text-[14px] text-ink-500 leading-[1.65]">Cone beam (scanner volumique) pour la planification implantaire et la chirurgie : chaque geste est préparé avant d’être réalisé.</p>
        </div>
        <div class="card">
          <h3 class="text-[18px] font-medium mb-2.5" style="font-family: var(--font-display)">Empreinte optique</h3>
          <p class="text-[14px] text-ink-500 leading-[1.65]">Caméra optique pour les empreintes numériques : sans pâte, plus confortable et d’une grande précision pour les restaurations et gouttières.</p>
        </div>
        <div class="card">
          <h3 class="text-[18px] font-medium mb-2.5" style="font-family: var(--font-display)">Travail sous digue</h3>
          <p class="text-[14px] text-ink-500 leading-[1.65]">Champ opératoire étanche systématique pour les collages : la condition d’une dentisterie adhésive fiable et durable.</p>
        </div>
        <div class="card">
          <h3 class="text-[18px] font-medium mb-2.5" style="font-family: var(--font-display)">Laboratoires français</h3>
          <p class="text-[14px] text-ink-500 leading-[1.65]">Restaurations céramiques et prothèses fixes conçues avec le <strong>laboratoire KF</strong> ; prothèses amovibles avec un laboratoire français dédié. Implants <strong>Anthogyr</strong>, fabricant français.</p>
        </div>
      </div>

      <!-- Hygiène & stérilisation : sobre — c’est la norme, pas un argument -->
      <div class="max-w-3xl mt-10 flex gap-4 items-start rounded-2xl p-5 md:p-6" style="background: var(--color-cream-200); border-left: 3px solid var(--color-teal-600)" data-reveal>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="flex-shrink-0 mt-0.5" style="color: var(--color-teal-700)"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z"/><path d="M9 12l2 2 4-4.5"/></svg>
        <p class="text-[14px] text-ink-700 leading-[1.65]">
          <strong>Hygiène & stérilisation.</strong> Le cabinet applique une chaîne complète de stérilisation des instruments, conforme aux référentiels en vigueur. Ce n’est pas un argument : c’est la norme — et elle est respectée sans compromis, pour chaque patient.
        </p>
      </div>
    </div>
  </section>


  <!-- VISITE / GALERIE -->
  <section class="container-wide pb-16 md:pb-24">
    <div class="max-w-3xl mb-8" data-reveal>
      <span class="eyebrow mb-4 block">La visite</span>
      <h2 class="text-[24px] md:text-[30px] leading-[1.25] tracking-tight" style="color: var(--color-teal-800)">Quelques images du cabinet</h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-4 md:gap-5" data-reveal>
      <figure class="m-0">
        <button type="button" class="gallery-item group relative block w-full p-0 aspect-[4/3] rounded-2xl overflow-hidden cursor-zoom-in" style="border:1px solid var(--color-cream-300)" data-full={salleSoinsFenetre.src} data-caption="Salle de soins">
          <Image src={salleSoinsFenetre} alt="Salle de soins lumineuse du cabinet dentaire à Colombes, fenêtre cintrée parisienne" widths={[480, 768, 896]} sizes="(min-width: 640px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
        </button>
        <figcaption class="text-[13px] text-ink-500 mt-2 ml-1">Salle de soins</figcaption>
      </figure>
      <figure class="m-0">
        <button type="button" class="gallery-item group relative block w-full p-0 aspect-[4/3] rounded-2xl overflow-hidden cursor-zoom-in" style="border:1px solid var(--color-cream-300)" data-full={salleSoinsBleue.src} data-caption="Salle de soins · empreinte optique 3D">
          <Image src={salleSoinsBleue} alt="Salle de soins équipée d'un scanner 3D (empreinte optique) au cabinet du Dr Kebieche à Colombes" widths={[480, 768, 1376]} sizes="(min-width: 640px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
        </button>
        <figcaption class="text-[13px] text-ink-500 mt-2 ml-1">Salle de soins · empreinte optique 3D</figcaption>
      </figure>
      <figure class="m-0">
        <button type="button" class="gallery-item group relative block w-full p-0 aspect-[4/3] rounded-2xl overflow-hidden cursor-zoom-in" style="border:1px solid var(--color-cream-300)" data-full={salleRadio.src} data-caption="Radiologie panoramique et cone beam (3D)">
          <Image src={salleRadio} alt="Salle de radiologie panoramique et cone beam (imagerie 3D) du cabinet dentaire à Colombes" widths={[480, 768, 896]} sizes="(min-width: 640px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
        </button>
        <figcaption class="text-[13px] text-ink-500 mt-2 ml-1">Radiologie panoramique &amp; cone beam (3D)</figcaption>
      </figure>
      <figure class="m-0">
        <button type="button" class="gallery-item group relative block w-full p-0 aspect-[4/3] rounded-2xl overflow-hidden cursor-zoom-in" style="border:1px solid var(--color-cream-300)" data-full={sterilisation.src} data-caption="Stérilisation">
          <Image src={sterilisation} alt="Zone de stérilisation et autoclave du cabinet dentaire du Dr Kebieche à Colombes" widths={[480, 768, 1376]} sizes="(min-width: 640px) 45vw, 100vw" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-[1.03]" loading="lazy" />
        </button>
        <figcaption class="text-[13px] text-ink-500 mt-2 ml-1">Stérilisation</figcaption>
      </figure>
    </div>
  </section>


  <!-- CTA -->
  <section class="container-wide py-16 md:py-24">
    <div class="rounded-3xl px-8 md:px-14 py-12 md:py-16" style="background: var(--color-teal-50); border: 1px solid var(--color-cream-300)">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
        <div>
          <h3 class="text-[26px] md:text-[32px] font-medium mb-2" style="font-family: var(--font-display)">Une première consultation ?</h3>
          <p class="text-[15px] text-ink-700">
            Examen, radiographies si nécessaire, plan de traitement détaillé. Sans engagement.
          </p>
        </div>
        <a href="https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes/booking/motives?specialityId=1&telehealth=false&placeId=practice-494254&source=profile" target="_blank" rel="noopener" class="btn btn-primary flex-shrink-0">
          Prendre rendez-vous
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox : clic sur une photo du cabinet → affichage en grand -->
  <div id="lightbox" class="fixed inset-0 z-[200] hidden items-center justify-center p-4" style="background: rgba(17, 19, 21, 0.94)">
    <button id="lightbox-close" type="button" aria-label="Fermer" class="absolute top-3 right-5 text-[36px] leading-none" style="color: var(--color-cream-100)">&times;</button>
    <figure class="m-0 flex flex-col items-center">
      <img id="lightbox-img" src="" alt="" class="max-w-[92vw] max-h-[84vh] rounded-xl object-contain" style="box-shadow: 0 20px 60px rgba(0,0,0,0.5)" />
      <figcaption id="lightbox-cap" class="text-[14px] mt-4" style="color: var(--color-cream-100)"></figcaption>
    </figure>
  </div>

  <script>
    (function () {
      const lb = document.getElementById('lightbox');
      if (!lb) return;
      const img = document.getElementById('lightbox-img');
      const cap = document.getElementById('lightbox-cap');
      const open = (src, alt, caption) => {
        img.src = src; img.alt = alt || ''; cap.textContent = caption || '';
        lb.classList.remove('hidden'); lb.classList.add('flex');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lb.classList.add('hidden'); lb.classList.remove('flex');
        img.src = ''; document.body.style.overflow = '';
      };
      document.querySelectorAll('.gallery-item').forEach((el) => {
        el.addEventListener('click', () => {
          const im = el.querySelector('img');
          open(el.dataset.full, im && im.alt, el.dataset.caption);
        });
      });
      document.getElementById('lightbox-close').addEventListener('click', close);
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !lb.classList.contains('hidden')) close(); });
    })();
  </script>

</Layout>
