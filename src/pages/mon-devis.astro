---
import Layout from '../layouts/Layout.astro';
import { soins, familles } from '../data/soins.js';

/**
 * Page patient PERSONNALISÉE (premium).
 * 2 modes :
 *  - RÉCIT (v2) : /mon-devis?d=<jeton> → fetch /api/devis (Cloudflare KV) → récit lia
 *    par phases (la « lettre clinique du Dr, mise en scène »).
 *  - FALLBACK (v1) : /mon-devis#<base64> → récap court + cartes pédago filtrées
 *    (anciens liens / KV indisponible).
 * Ce n'est PAS le devis officiel (PDF Logos signé) : c'est sa version expliquée. noindex.
 */
---

<Layout
  title="Votre devis expliqué — Cabinet Dr Sohaïb Kebieche, Colombes"
  description="Votre plan de traitement, expliqué étape par étape."
  noindex={true}
>
  <!-- En-tête personnel -->
  <section class="container-wide pt-12 md:pt-20 pb-6 md:pb-8">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">Votre plan de traitement, expliqué</span>
      <p id="md-salut" class="text-[17px] md:text-[19px] font-semibold mb-3 hidden" style="color: var(--color-teal-700)"></p>
      <h1 class="text-[32px] md:text-[44px] leading-[1.12] tracking-tight mb-6">
        Votre plan de traitement, étape par étape.
      </h1>
      <p id="md-objectif" class="text-[17px] text-ink-700 leading-[1.7]">
        Cette page accompagne le devis remis en consultation : chaque soin prévu y est expliqué simplement, à relire à tête reposée. Pour toute question : <a href="tel:+33142429469" class="font-semibold whitespace-nowrap" style="color: var(--color-teal-700)">01 42 42 94 69</a>.
      </p>
    </div>
  </section>

  <!-- MODE RÉCIT (KV) : phases rendues côté client -->
  <section class="container-wide pb-4 hidden" id="md-recit">
    <div class="max-w-3xl" id="md-phases"></div>
  </section>

  <!-- Conseils (ex : apporter sa brosse électrique) -->
  <section class="container-wide pb-6 hidden" id="md-conseils">
    <div class="max-w-3xl card !p-6" style="background: var(--color-cream-50); border-color: var(--color-cream-300)">
      <div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-3" style="color: var(--color-copper-600)">Pour préparer vos séances</div>
      <ul id="md-conseils-list" class="text-[15px] text-ink-800 leading-[1.8] list-disc pl-5"></ul>
    </div>
  </section>

  <!-- Reste à charge (mode récit) -->
  <section class="container-wide pb-6 hidden" id="md-rac">
    <div class="max-w-3xl card !p-6" style="background: var(--color-cream-50); border-color: var(--color-cream-300)">
      <div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-2" style="color: var(--color-copper-600)">Montant du devis</div>
      <div id="md-rac-montant" class="text-[30px] md:text-[34px] leading-none mb-1.5" style="font-family: var(--font-display); color: var(--color-teal-700)"></div>
      <div class="text-[13px] text-ink-500 mb-3">à régler, puis remboursé par l'Assurance Maladie et votre mutuelle</div>
      <p class="text-[14px] text-ink-700 leading-[1.6]">Transmettez votre devis à votre mutuelle pour estimer votre remboursement.</p>
    </div>
  </section>

  <!-- MODE FALLBACK (fragment v1) : récap court + cartes pédago -->
  <section class="container-wide pb-2 hidden" id="md-recap">
    <div class="max-w-3xl card !p-6" style="background: var(--color-cream-50); border-color: var(--color-cream-300)">
      <div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-3" style="color: var(--color-copper-600)">Les soins de votre devis</div>
      <ul id="md-recap-list" class="text-[15px] text-ink-800 leading-[1.9] list-disc pl-5"></ul>
    </div>
  </section>

  <section class="container-wide pb-16 hidden" id="md-vide">
    <div class="max-w-3xl card !p-6">
      <p class="text-[15px] text-ink-700 leading-[1.65]">
        Ce lien s'ouvre depuis le mail de votre devis. S'il semble incomplet, appelez-nous au
        <a href="tel:+33142429469" class="font-semibold whitespace-nowrap" style="color: var(--color-teal-700)"> 01 42 42 94 69</a>, nous nous occupons de tout.
      </p>
    </div>
  </section>

  <section class="container-wide pt-4 pb-12 md:pb-16 hidden" id="md-cards">
    <div class="max-w-4xl">
      {familles.map((f) => (
        <div class="mon-groupe mb-10 last:mb-0 hidden" data-famille={f}>
          <div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-5" style="color: var(--color-copper-600)">{f}</div>
          <div class="grid md:grid-cols-2 gap-5">
            {soins.filter((s) => s.famille === f).map((s) => (
              <a href={s.href} class="card !p-6 block mon-soin hidden" data-soin={s.key} data-titre={s.titre}>
                <h2 class="text-[18px] font-medium mb-2" style="font-family: var(--font-display)">{s.titre}</h2>
                <p class="text-[14px] text-ink-700 leading-[1.65] mb-3">{s.resume}</p>
                <span class="text-[13.5px] font-medium inline-flex items-center gap-1.5" style="color: var(--color-teal-700)">
                  Lire l'explication complète <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                </span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Disclaimer officiel (commun) -->
  <section class="container-wide pb-8">
    <div class="max-w-3xl flex gap-4 items-start rounded-2xl p-5 md:p-6" style="background: var(--color-cream-200); border-left: 3px solid var(--color-copper-400)" data-reveal>
      <p class="text-[13.5px] text-ink-700 leading-[1.65]">
        <strong>Votre devis fait référence.</strong> Le document officiel — remis et signé en consultation — décrit précisément votre plan de traitement et ses montants. Cette page n'en est que l'explication.
      </p>
    </div>
  </section>

  <!-- CTA (commun) -->
  <section class="container-wide pb-24">
    <div class="card p-10 md:p-14 text-center max-w-3xl" style="background: var(--color-cream-50); border-color: var(--color-cream-300)" data-reveal>
      <p id="md-cloture" class="text-[15px] text-ink-600 mb-7 max-w-xl mx-auto leading-[1.7]">
        Lorsque vous souhaiterez commencer, indiquez-le-nous : le secrétariat vous rappellera pour fixer ensemble vos premiers rendez-vous. Je reste à votre entière disposition pour toute question.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/rappel" id="md-rdv" class="btn btn-primary whitespace-nowrap">Je souhaite prendre rendez-vous</a>
        <a href="tel:+33142429469" class="btn btn-secondary whitespace-nowrap">01 42 42 94 69</a>
      </div>
    </div>
  </section>

  <style is:global>
    /* Carte "soin" injectee par JS -> clairement cliquable (vers le schema anime) */
    .soin-link { display:flex; align-items:center; gap:.8rem; margin-top:1rem; padding:.75rem 1rem; border-radius:.9rem; border:1px solid var(--color-cream-300); background:var(--color-cream-50); transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease; text-decoration:none; }
    .soin-link:hover { transform:translateY(-2px); box-shadow:0 10px 28px rgba(31,58,61,.10); border-color:var(--color-copper-400); }
    .soin-link .ico { flex:0 0 auto; display:grid; place-items:center; width:2.3rem; height:2.3rem; border-radius:9999px; background:var(--color-teal-700); color:#fff; }
    .soin-link .lbl { flex:1 1 auto; font-size:14.5px; font-weight:600; color:var(--color-teal-800); line-height:1.3; }
    .soin-link .arr { flex:0 0 auto; color:var(--color-copper-600); font-size:18px; font-weight:600; }
    /* "Voir le deroule" = divulgation progressive du COMMENT */
    .deroule { margin-top:.5rem; }
    .deroule > summary { cursor:pointer; list-style:none; font-size:14px; font-weight:600; color:var(--color-teal-700); display:inline-flex; align-items:center; gap:.5rem; padding:.3rem 0; }
    .deroule > summary::-webkit-details-marker { display:none; }
    .deroule > summary .pm { display:inline-grid; place-items:center; width:1.2rem; height:1.2rem; border-radius:9999px; border:1.5px solid currentColor; font-size:12px; line-height:1; }
    .deroule:not([open]) > summary .pm::before { content:'+'; }
    .deroule[open] > summary .pm::before { content:'\2212'; }
    .deroule .deroule-body { margin-top:.7rem; }
  </style>

  <script type="application/json" id="soins-data" set:html={JSON.stringify(soins)} is:inline></script>

  <script is:inline>
    (function () {
      var SOINS = {};
      try { JSON.parse(document.getElementById('soins-data').textContent).forEach(function (s) { SOINS[s.key] = s; }); } catch (e) {}
      var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); };
      var params = new URLSearchParams(location.search);
      var d = params.get('d');

      function setRdv(jeton, nom) {
        var rdv = document.getElementById('md-rdv');
        if (!rdv) return;
        var u = '/rappel?r=' + encodeURIComponent(jeton || '');
        if (nom) u += '&p=' + encodeURIComponent(nom);
        u += '&utm_source=melyia&utm_medium=email&utm_campaign=mondevis';
        rdv.setAttribute('href', u);
      }

      function carteSoin(key) {
        var s = SOINS[key];
        if (!s) return '';
        return '<a href="' + esc(s.href) + '" class="soin-link">' +
          '<span class="ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg></span>' +
          '<span class="lbl">Voir « ' + esc(s.titre) + ' » en images</span>' +
          '<span class="arr">&rarr;</span></a>';
      }

      // ---- MODE RÉCIT (KV) ----
      function renderRecit(r) {
        if (r.salutation) { var sal = document.getElementById('md-salut'); sal.textContent = r.salutation + ','; sal.classList.remove('hidden'); }
        if (r.objectif) {
          document.getElementById('md-objectif').innerHTML =
            'Suite à notre consultation, je vous adresse le détail de votre plan de traitement. ' + esc(r.objectif);
        }
        var phasesEl = document.getElementById('md-phases');
        var html = '';
        (r.phases || []).forEach(function (ph, i) {
          html += '<div class="mb-10">';
          html += '<div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-2" style="color:var(--color-copper-600)">Étape ' + (i + 1) + '</div>';
          html += '<h2 class="text-[22px] md:text-[26px] mb-4" style="font-family:var(--font-display); color:var(--color-teal-800)">' + esc(ph.titre) + '</h2>';
          var paras = ph.paragraphes || [];
          // POURQUOI (1er paragraphe) : toujours visible
          if (paras[0]) html += '<p class="text-[16px] text-ink-700 leading-[1.75] mb-4">' + esc(paras[0]) + '</p>';
          // passerelle visuelle vers le(s) schema(s)
          (ph.soinsKeys || []).forEach(function (k) { html += carteSoin(k); });
          // COMMENT (paragraphes suivants) : replie ("on range, on ne coupe pas")
          if (paras.length > 1) {
            html += '<details class="deroule"><summary><span class="pm"></span>Voir le déroulé du soin</summary><div class="deroule-body">';
            for (var pi = 1; pi < paras.length; pi++) html += '<p class="text-[16px] text-ink-700 leading-[1.75] mb-4">' + esc(paras[pi]) + '</p>';
            html += '</div></details>';
          }
          html += '</div>';
        });
        phasesEl.innerHTML = html;
        document.getElementById('md-recit').classList.remove('hidden');
        if (Array.isArray(r.conseils) && r.conseils.length) {
          document.getElementById('md-conseils-list').innerHTML = r.conseils.map(function (c) { return '<li>' + esc(c) + '</li>'; }).join('');
          document.getElementById('md-conseils').classList.remove('hidden');
        }
        if (r.rac) {
          document.getElementById('md-rac-montant').textContent = r.rac + ' €';
          document.getElementById('md-rac').classList.remove('hidden');
        }
        if (r.cloture) document.getElementById('md-cloture').textContent = r.cloture;
        setRdv(r.jeton || d, r.nom);
      }

      // ---- MODE FALLBACK (fragment) ----
      function dec(s) { s = s.replace(/-/g, '+').replace(/_/g, '/'); while (s.length % 4) s += '='; try { return decodeURIComponent(escape(atob(s))); } catch (e) { return null; } }
      function renderFallback() {
        var raw = (location.hash || '').replace(/^#/, '');
        var data = null;
        if (raw) { var j = dec(raw); if (j) { try { data = JSON.parse(j); } catch (e) {} } }
        if (!data || !Array.isArray(data.s) || !data.s.length) { document.getElementById('md-vide').classList.remove('hidden'); return; }
        if (data.p) { var sal = document.getElementById('md-salut'); sal.textContent = data.p + ','; sal.classList.remove('hidden'); }
        var titres = [];
        document.getElementById('md-cards').classList.remove('hidden');
        document.querySelectorAll('.mon-soin').forEach(function (c) {
          if (data.s.indexOf(c.dataset.soin) !== -1) { c.classList.remove('hidden'); titres.push(c.dataset.titre); }
        });
        document.querySelectorAll('.mon-groupe').forEach(function (g) { if (g.querySelector('.mon-soin:not(.hidden)')) g.classList.remove('hidden'); });
        if (titres.length) {
          document.getElementById('md-recap-list').innerHTML = titres.map(function (t) { return '<li>' + esc(t) + '</li>'; }).join('');
          document.getElementById('md-recap').classList.remove('hidden');
        }
        setRdv(data.j, data.n);
      }

      if (d) {
        fetch('/api/devis?d=' + encodeURIComponent(d))
          .then(function (res) { if (!res.ok) throw new Error('kv'); return res.json(); })
          .then(renderRecit)
          .catch(function () { renderFallback(); });
      } else {
        renderFallback();
      }
    })();
  </script>
</Layout>
