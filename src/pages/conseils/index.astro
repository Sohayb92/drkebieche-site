---
import Layout from '../../layouts/Layout.astro';

const groupes = [
  {
    nom: 'Préparer sa venue',
    fiches: [
      {
        href: '/conseils/premiere-consultation',
        titre: 'Votre première consultation',
        desc: "Comment se déroule un premier rendez-vous, combien de temps il dure, et quoi apporter pour qu’il soit le plus utile possible.",
      },
      {
        href: '/conseils/avant',
        titre: 'Avant une intervention',
        desc: "Bien se préparer à une extraction, un implant, une greffe ou une chirurgie : médicaments, repas, organisation.",
      },
    ],
  },
  {
    nom: 'Après vos soins',
    fiches: [
      {
        href: '/conseils/apres-chirurgie',
        titre: 'Après une chirurgie',
        desc: "Extraction, dents de sagesse, implant, greffe osseuse : les consignes des premières 24 h aux jours suivants.",
      },
      {
        href: '/conseils/apres-parodontologie',
        titre: 'Après un soin parodontal',
        desc: "Greffe de gencive (tunneling) ou débridement : protéger la zone opérée, gérer les sensibilités.",
      },
      {
        href: '/conseils/blanchiment',
        titre: 'Pendant votre blanchiment',
        desc: "Bien utiliser les gouttières : dose de gel, port 2 h par jour, aliments à limiter, sensibilités.",
      },
    ],
  },
  {
    nom: 'Au quotidien',
    fiches: [
      {
        href: '/conseils/hygiene',
        titre: 'Hygiène : les bons gestes',
        desc: "Brossage à 45° vers la gencive, brosse électrique, brossettes calibrées — schémas à l’appui.",
      },
      {
        href: '/conseils/maintenance-implants',
        titre: 'Entretenir ses implants',
        desc: "Brossettes autour de l’implant, contrôles réguliers, et les signes qui doivent faire appeler.",
      },
    ],
  },
];
---

<Layout
  title="Conseils patient — fiches et consignes du cabinet Dr Kebieche, Colombes"
  description="Les fiches conseils du cabinet dentaire Dr Kebieche (Colombes) : première consultation, consignes avant et après chirurgie, soins parodontaux, blanchiment, hygiène quotidienne."
>

  <section class="container-wide pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">Conseils patient</span>
      <h1 class="text-[28px] md:text-[36px] leading-[1.2] tracking-tight mb-5" style="color: var(--color-teal-800)">
        Fiches conseils & consignes de soins<br>
        <span class="text-ink-700">— cabinet dentaire, Colombes (92)</span>
      </h1>
      <p class="text-[22px] md:text-[26px] leading-[1.25] mb-6" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
        Tout ce qu’il faut savoir, avant et après vos soins.
      </p>
      <p class="text-[16px] text-ink-700 leading-[1.7]">
        Ces fiches reprennent, à tête reposée, les explications et consignes données au fauteuil — schémas à l’appui. Après une intervention, le lien vers la fiche correspondante accompagne vos consignes écrites.
      </p>
    </div>
  </section>

  <section class="container-wide pb-24 md:pb-32">
    {groupes.map((g) => (
      <div class="mb-12 last:mb-0">
        <div class="text-[12px] uppercase tracking-[0.18em] font-semibold mb-5" style="color: var(--color-copper-600)" data-reveal>{g.nom}</div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
          {g.fiches.map((f, idx) => (
            <a href={f.href} class="card hover:border-teal-300 transition-colors group p-6 md:p-7" data-reveal data-reveal-delay={(idx * 80).toString()}>
              <h2 class="text-[19px] md:text-[20px] font-medium mb-2.5" style="font-family: var(--font-display)">{f.titre}</h2>
              <p class="text-[14px] text-ink-500 leading-[1.6] mb-4">{f.desc}</p>
              <span class="text-[13px] font-medium inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
                Consulter <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>

</Layout>
