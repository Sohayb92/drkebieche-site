---
import Layout from '../../layouts/Layout.astro';

const soins = [
  {
    slug: 'implantologie',
    title: 'Implantologie',
    desc: 'Remplacement de racines manquantes par des implants, comblements osseux, greffes pré-implantaires.',
    keywords: 'implants · comblement osseux · greffes',
  },
  {
    slug: 'parodontologie',
    title: 'Parodontologie',
    desc: 'Soin des gencives et de l\'os de soutien : bilan parodontal, assainissement, maintenance préventive.',
    keywords: 'gencives · déchaussement · maintenance',
  },
  {
    slug: 'dentisterie-adhesive',
    title: 'Dentisterie adhésive',
    desc: 'Reconstructions partielles en céramique (inlays, onlays, overlays) et composites stratifiés sous digue.',
    keywords: 'inlay · onlay · overlay · composite',
  },
  {
    slug: 'chirurgie-orale',
    title: 'Chirurgie orale & avulsions',
    desc: 'Extractions complexes, dents de sagesse, kystes — savoir-faire issu d\'une formation hospitalière.',
    keywords: 'dents de sagesse · extractions · kystes',
  },
  {
    slug: 'blanchiment',
    title: 'Blanchiment dentaire',
    desc: 'Éclaircissement au cabinet et à domicile, sur dents vivantes ou dévitalisées.',
    keywords: 'blanchiment · éclaircissement',
  },
];
---

<Layout
  title="Tous les soins — Cabinet Dr Sohaïb Kebieche, Colombes"
  description="Implantologie, parodontologie, dentisterie adhésive, chirurgie orale, blanchiment. Soins dentaires d'excellence à Colombes (92)."
>

  <section class="container-wide pt-16 md:pt-24 pb-12 md:pb-16">
    <div class="max-w-3xl">
      <span class="eyebrow mb-5">Tous les soins</span>
      <h1 class="text-[40px] md:text-[56px] leading-[1.1] tracking-tight mb-6">
        Une dentisterie complète,<br>
        <span class="italic text-sage-600">précise et durable.</span>
      </h1>
      <p class="text-[18px] text-ink-700 leading-[1.65]">
        Du soin courant aux interventions complexes — implantologie, parodontologie, dentisterie adhésive moderne. Chaque soin est expliqué en détail avant d'être réalisé.
      </p>
    </div>
  </section>

  <section class="container-wide pb-24">
    <div class="grid md:grid-cols-2 gap-6 md:gap-8">
      {soins.map((s) => (
        <a href={`/soins/${s.slug}`} class="group card hover:shadow-xl hover:-translate-y-1 transition-all duration-500 cursor-pointer">
          <h2 class="text-[26px] md:text-[30px] font-display tracking-tight mb-3">{s.title}</h2>
          <p class="text-[15px] text-ink-700 leading-[1.7] mb-4">{s.desc}</p>
          <div class="text-[12px] text-ink-500 uppercase tracking-[0.15em] mb-5">{s.keywords}</div>
          <span class="text-[14px] text-sage-700 font-medium group-hover:underline underline-offset-4">
            En savoir plus →
          </span>
        </a>
      ))}
    </div>
  </section>

</Layout>
