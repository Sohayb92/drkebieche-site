---
import Layout from '../../layouts/Layout.astro';

// 4 familles médicales avec leurs soins individuels.
// Chaque sous-soin pointe vers la section ancrée de la page mère.
// Mélyia peut utiliser ces URLs précises dans les mails de relance devis.
const familles = [
  {
    slug: 'implantologie-chirurgie',
    titre: 'Implantologie & chirurgie',
    intro: "Pose d’implants, reconstruction osseuse pré-implantaire et chirurgie orale. Une expérience hospitalière en chirurgie orale couplée à un D.U. récent (implantologie et esthétique dentaire, Université d’Évry Paris-Saclay, 2024) au service des cas complexes.",
    icon: 'circle',
    soins: [
      { titre: "Pose d’implants dentaires", hash: 'implants' },
      { titre: "Comblement osseux après extraction", hash: 'comblement-alveolaire' },
      { titre: "Reconstruction osseuse pré-implantaire", hash: 'greffes-osseuses' },
      { titre: "Chirurgie orale & extractions complexes", hash: 'chirurgie-orale' },
      { titre: "Dents de sagesse", hash: 'dents-de-sagesse' },
    ],
  },
  {
    slug: 'parodontologie',
    titre: 'Parodontologie',
    intro: "La parodontite est une infection bactérienne qui détruit les tissus de soutien de la dent (gencive et os alvéolaire) et peut mener à la perte des dents sans traitement. Une prise en charge qui s’appuie sur un D.U. de Parodontologie avancée (2025) et la formation Tunneling Academy.",
    icon: 'wave',
    soins: [
      { titre: "Soin médical des gencives", hash: 'soin-gencives' },
      { titre: "Traitement des récessions gingivales", hash: 'recessions-gingivales' },
      { titre: "Maintenance parodontale", hash: 'maintenance' },
    ],
  },
  {
    slug: 'dentisterie-adhesive-protheses',
    titre: 'Dentisterie adhésive & prothèses',
    intro: "Restaurer en préservant le maximum de tissu dentaire sain. La dentisterie adhésive moderne (inlays, onlays, overlays céramiques, composites stratifiés sous digue) prolonge la vie d’une dent. Les prothèses fixes (couronnes, bridges) sont conçues avec un laboratoire de prothèse français.",
    icon: 'diamond',
    soins: [
      { titre: "Inlays, onlays, overlays céramiques", hash: 'inlay-onlay-overlay' },
      { titre: "Composites stratifiés sous digue", hash: 'composites' },
      { titre: "Facettes céramiques", hash: 'facettes' },
      { titre: "Couronnes & bridges", hash: 'couronnes-bridges' },
      { titre: "Prothèses sur implants", hash: 'protheses-implants' },
      { titre: "Prothèses amovibles (complètes & partielles)", hash: 'protheses-amovibles' },
    ],
  },
  {
    slug: 'soins-quotidiens',
    titre: 'Soins du quotidien',
    intro: "Toute la dentisterie courante au même endroit, dans la continuité des soins complexes. Caries, dévitalisations, détartrage, urgences, suivi régulier — la base d’une bouche en bonne santé sur le long terme. Le blanchiment dentaire est également proposé.",
    icon: 'plus',
    soins: [
      { titre: "Soins des caries", hash: 'caries' },
      { titre: "Traitement de racine (dévitalisation)", hash: 'endodontie' },
      { titre: "Retraitement de racine", hash: 'retraitement' },
      { titre: "Contrôle annuel & détartrage", hash: 'detartrage' },
      { titre: "Urgences dentaires", hash: 'urgences' },
      { titre: "Gouttière occlusale (bruxisme)", hash: 'gouttiere-bruxisme' },
      { titre: "Blanchiment dentaire", hash: 'blanchiment' },
    ],
  },
];

// Vignettes mini-schémas : dessin au trait par famille (cohérent avec les schémas pédagogiques)
function iconSvg(name: string) {
  const c = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
  switch (name) {
    case 'circle': // implant : couronne + pilier + vis
      return `<svg width="44" height="44" viewBox="0 0 48 48" ${c}>
        <path d="M16 15 q8 -8 16 0 l-1.5 6 h-13 z"/>
        <path d="M21 21 h6 v3.5 h-6 z"/>
        <path d="M20 24.5 h8 l-1.3 13 q-2.7 4.5 -5.4 0 z"/>
        <line x1="20.6" y1="29" x2="27.4" y2="29"/>
        <line x1="21" y1="33" x2="27" y2="33"/>
      </svg>`;
    case 'wave': // paro : dent + ligne de gencive
      return `<svg width="44" height="44" viewBox="0 0 48 48" ${c}>
        <path d="M17 14 q7 -6 14 0 q3.5 3 2.5 9 q-1 7 -3.5 12 q-1.8 3.5 -3.4 -1.5 q-1.2 -4 -2.6 -4 q-1.4 0 -2.6 4 q-1.6 5 -3.4 1.5 q-2.5 -5 -3.5 -12 q-1 -6 2.5 -9 z"/>
        <path d="M8 22 q5 -4 10 -1.5" />
        <path d="M30 20.5 q5 -2.5 10 1.5" />
      </svg>`;
    case 'diamond': // adhésif : dent + pièce céramique (vue éclatée)
      return `<svg width="44" height="44" viewBox="0 0 48 48" ${c}>
        <path d="M17 22 q7 -5 14 0 q3.5 3 2.5 8 q-1 6 -3.5 10 q-1.8 3 -3.4 -1.2 q-1.2 -3.5 -2.6 -3.5 q-1.4 0 -2.6 3.5 q-1.6 4.2 -3.4 1.2 q-2.5 -4 -3.5 -10 q-1 -5 2.5 -8 z"/>
        <polygon points="24 6 29 11 24 16 19 11"/>
        <line x1="24" y1="17.5" x2="24" y2="20.5"/>
      </svg>`;
    case 'plus': // quotidien : dent + croix de soin
      return `<svg width="44" height="44" viewBox="0 0 48 48" ${c}>
        <path d="M15 18 q8 -7 16 0 q4 3.5 3 10 q-1.2 8 -4 13.5 q-2 4 -3.8 -1.5 q-1.4 -4.5 -3.2 -4.5 q-1.8 0 -3.2 4.5 q-1.8 5.5 -3.8 1.5 q-2.8 -5.5 -4 -13.5 q-1 -6.5 3 -10 z"/>
        <line x1="37" y1="7" x2="37" y2="15"/>
        <line x1="33" y1="11" x2="41" y2="11"/>
      </svg>`;
    default: return '';
  }
}
---

<Layout
  title="Soins dentaires à Colombes — Dr Sohaïb Kebieche, implantologie, parodontologie, dentisterie adhésive"
  description="Cabinet dentaire à Colombes (92700). Implantologie, parodontologie, dentisterie adhésive sous digue, chirurgie orale. Tous les soins expliqués en détail."
>

  <!-- HERO page /soins -->
  <section class="container-wide pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">Tous les soins</span>
      <h1 class="text-[28px] md:text-[36px] leading-[1.2] tracking-tight mb-5" style="color: var(--color-teal-800)">
        Soins conservateurs, prothèses, implants
        <span class="block mt-2 text-[15px] md:text-[17px] font-semibold tracking-normal text-ink-500" style="font-family: var(--font-body)">Dentisterie complète à Colombes (92)</span>
      </h1>
      <p class="text-[22px] md:text-[28px] leading-[1.25] mb-5" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
        Une dentisterie complète, précise et durable.
      </p>
      <p class="text-[16px] text-ink-700 leading-[1.7]">
        Du soin courant aux interventions complexes — quatre domaines d’expertise qui couvrent l’essentiel de la dentisterie moderne. Chaque soin est expliqué en détail avant d’être réalisé.
      </p>
    </div>
  </section>


  <!-- 4 familles avec sous-listes -->
  <section class="container-wide pb-24 md:pb-32">
    <div class="space-y-6 md:space-y-8">
      {familles.map((f, idx) => (
        <article class="card p-7 md:p-10" style={idx % 2 === 1 ? 'background: var(--color-teal-50)' : undefined} data-reveal data-reveal-delay={(idx * 120).toString()}>
          <div class="grid md:grid-cols-[1fr_1.4fr] gap-8 md:gap-12 items-start">

            <!-- Colonne gauche : vignette + titre + intro -->
            <div>
              <div class="w-16 h-16 rounded-xl flex items-center justify-center mb-6" style={`background: ${idx % 2 === 1 ? 'var(--color-cream-50)' : 'var(--color-cream-200)'}; color: var(--color-teal-800)`}>
                <Fragment set:html={iconSvg(f.icon)} />
              </div>
              <h2 class="text-[24px] md:text-[28px] font-medium mb-4" style="font-family: var(--font-display)">{f.titre}</h2>
              <p class="text-[15px] text-ink-700 leading-[1.7] mb-5">{f.intro}</p>
              <a href={`/soins/${f.slug}`} class="text-[14px] font-medium inline-flex items-center gap-1.5 hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
                Page complète <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
              </a>
            </div>

            <!-- Colonne droite : liste des soins individuels -->
            <div>
              <div class="text-[11px] uppercase tracking-[0.18em] font-semibold mb-4" style="color: var(--color-teal-700)">
                Soins individuels
              </div>
              <ul class="space-y-1">
                {f.soins.map(s => (
                  <li>
                    <a href={`/soins/${f.slug}#${s.hash}`} class="group flex items-center justify-between py-3 px-3 -mx-3 rounded-lg hover:bg-cream-50 transition-colors">
                      <span class="text-[15px] text-ink-900">{s.titre}</span>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="opacity-30 group-hover:opacity-100 transition-opacity" style="color: var(--color-teal-700)"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </article>
      ))}
    </div>
  </section>


  <!-- Clôture : dernier appel à l’action -->
  <section class="container-wide pb-24 md:pb-32">
    <div class="rounded-3xl px-8 md:px-14 py-12 md:py-16 text-center" style="background: var(--color-teal-50); border: 1px solid var(--color-cream-300)" data-reveal>
      <h2 class="text-[26px] md:text-[34px] font-medium mb-3" style="font-family: var(--font-display)">
        Vous ne savez pas par où commencer ?
      </h2>
      <p class="text-[15px] text-ink-700 mb-7 max-w-xl mx-auto">
        La première consultation sert exactement à ça : un examen complet, et un plan clair — expliqué, écrit, sans engagement.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes/booking/motives?specialityId=1&telehealth=false&placeId=practice-494254&source=profile" target="_blank" rel="noopener" class="btn btn-primary">
          Prendre rendez-vous
        </a>
        <a href="/conseils/premiere-consultation" class="btn btn-secondary">
          Comment ça se passe
        </a>
      </div>
    </div>
  </section>

</Layout>
