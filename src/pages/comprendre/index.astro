---
import Layout from '../../layouts/Layout.astro';

const fiches = [
  {
    href: '/comprendre/premiere-consultation',
    titre: 'Votre première consultation',
    desc: "Comment se déroule un premier rendez-vous, combien de temps il dure, et quoi apporter pour qu'il soit le plus utile possible.",
  },
  {
    href: '/comprendre/avant',
    titre: "Avant une intervention",
    desc: "Conseils pré-opératoires pour les extractions, implants, greffes et chirurgies parodontales : comment bien se préparer.",
  },
  {
    href: '/comprendre/apres',
    titre: "Après une intervention",
    desc: "Consignes post-opératoires : saignement, gonflement, alimentation, hygiène — ce qui est normal et ce qui doit alerter.",
  },
  {
    href: '/comprendre/hygiene',
    titre: 'Hygiène au quotidien',
    desc: "Brossage, brossettes interdentaires, alimentation : tout ce qui se joue à la maison entre deux rendez-vous.",
  },
];
---

<Layout
  title="Comprendre vos soins — guides et consignes du cabinet Dr Kebieche, Colombes"
  description="Guides pédagogiques du cabinet dentaire Dr Kebieche : première consultation, consignes avant et après intervention, hygiène quotidienne."
>

  <section class="container-wide pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">Comprendre vos soins</span>
      <h1 class="text-[28px] md:text-[36px] leading-[1.2] tracking-tight mb-5" style="color: var(--color-teal-800)">
        Guides patient & consignes de soins<br>
        <span class="text-ink-700">— cabinet dentaire, Colombes (92)</span>
      </h1>
      <p class="text-[22px] md:text-[26px] leading-[1.25] mb-6" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
        Un patient qui comprend est un patient mieux soigné.
      </p>
      <p class="text-[16px] text-ink-700 leading-[1.7]">
        Après chaque consultation, le plan de traitement remis est accompagné de liens vers ces pages : vous y retrouvez, à tête reposée, les explications données au fauteuil — schémas à l'appui.
      </p>
    </div>
  </section>

  <section class="container-wide pb-24 md:pb-32">
    <div class="grid md:grid-cols-2 gap-5">
      {fiches.map((f, idx) => (
        <a href={f.href} class="card hover:border-teal-300 transition-colors group p-7 md:p-9" data-reveal data-reveal-delay={(idx * 90).toString()}>
          <h2 class="text-[21px] md:text-[23px] font-medium mb-3" style="font-family: var(--font-display)">{f.titre}</h2>
          <p class="text-[14.5px] text-ink-500 leading-[1.65] mb-5">{f.desc}</p>
          <span class="text-[13px] font-medium inline-flex items-center gap-1.5 group-hover:gap-2.5 transition-all" style="color: var(--color-teal-700)">
            Consulter <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

</Layout>
