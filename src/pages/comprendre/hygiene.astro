---
import FamilySoinsPage from '../../components/FamilySoinsPage.astro';

const sections = [
  {
    id: 'brossage',
    titre: 'Le brossage',
    description: `
      <p><strong>Deux fois par jour, deux minutes</strong>, matin et soir — le brossage du soir est le plus important : c'est lui qui protège pendant la nuit.</p>
      <ul>
        <li>Une <strong>brosse à dents électrique</strong> est recommandée (la référence conseillée en consultation utilise une technologie ultrasonique) : elle fait le travail mieux et plus régulièrement qu'une brosse manuelle.</li>
        <li><strong>Sans appuyer</strong> : c'est le passage répété qui nettoie, pas la force. Un brossage trop appuyé use l'émail et fait reculer la gencive.</li>
        <li>Un <strong>dentifrice fluoré</strong> classique suffit. Recracher sans rincer abondamment : le fluor continue d'agir après le brossage.</li>
      </ul>
    `,
  },
  {
    id: 'interdentaire',
    titre: "L'interdentaire : là où la brosse ne passe pas",
    description: `
      <p>La brosse ne nettoie que 3 faces sur 5. Les espaces entre les dents — là où naissent la plupart des caries et l'inflammation des gencives — demandent un outil dédié, <strong>une fois par jour</strong> :</p>
      <ul>
        <li><strong>Brossettes interdentaires</strong> : l'outil de référence. La bonne taille compte autant que le geste — c'est pourquoi le <strong>calibrage est réalisé au cabinet</strong> et les brossettes adaptées remises en fin de séance.</li>
        <li><strong>Fil dentaire</strong> : pour les espaces trop serrés pour la plus petite brossette.</li>
        <li><strong>Saignement au passage ?</strong> Ce n'est pas une raison d'arrêter — c'est le signe d'une gencive inflammée qui a justement besoin d'être nettoyée. Si le saignement persiste après 10-15 jours d'usage régulier, parlez-en en consultation.</li>
      </ul>
    `,
  },
  {
    id: 'alimentation-habitudes',
    titre: 'Alimentation & habitudes',
    description: `
      <ul>
        <li><strong>Le sucre</strong> : c'est moins la quantité que la <em>fréquence</em> qui compte. Grignotages et boissons sucrées sirotées au fil de la journée (sodas, jus, thé sucré) entretiennent une attaque acide permanente.</li>
        <li><strong>Les boissons acides</strong> (sodas même light, jus d'agrumes) érodent l'émail : à consommer au cours des repas plutôt qu'en dehors.</li>
        <li><strong>Le tabac</strong> : au-delà du reste, c'est le premier facteur aggravant des maladies de gencives — et il masque leurs signes d'alerte (le saignement).</li>
        <li><strong>Les bains de bouche</strong> : utiles sur prescription, pour une durée limitée. Au quotidien, ils ne remplacent ni le brossage ni les brossettes.</li>
      </ul>
      <p>Et une fois par an : <strong>contrôle, radiographies et détartrage</strong> — le rendez-vous qui permet de tout traiter quand c'est encore simple.</p>
    `,
  },
];
