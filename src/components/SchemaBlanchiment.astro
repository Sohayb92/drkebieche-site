---
/**
 * Blanchiment v2 — protocole en 3 temps, vue de face simplifiée (3 dents + gencive).
 * P1 : empreinte (porte-empreinte qui descend) · P2 : gouttière + gel · P3 : gouttière portée + 2h/j.
 */
const steps = [
  { num: '1', duree: '1re séance', titre: 'Empreinte au cabinet', ligne: 'Une empreinte des dents permet de fabriquer vos gouttières sur mesure.' },
  { num: '2', duree: 'Une semaine après', titre: 'Gouttières + gel remis', ligne: 'Une goutte de gel par dent, dans la gouttière — les explications sont données au cabinet.' },
  { num: '3', duree: '4 à 6 semaines', titre: 'Port : 2h par jour minimum', ligne: 'Chaque jour, pendant 4 à 6 semaines. Le résultat se maintient en général 3 à 5 ans.' },
];

// Dents de face (3 incisives, bas arrondi) — base commune
const TEETH = [
  'M 44 42 L 44 80 C 44 94 76 94 76 80 L 76 42 Z',
  'M 84 42 L 84 84 C 84 98 116 98 116 84 L 116 42 Z',
  'M 124 42 L 124 80 C 124 94 156 94 156 80 L 156 42 Z',
];
// Silhouette de la gouttière (englobe les 3 dents, bord ondulé)
const TRAY = 'M 38 38 L 162 38 L 162 80 C 162 99 148 101 140 92 C 134 102 122 103 100 103 C 78 103 66 102 60 92 C 52 101 38 99 38 80 Z';
---

<figure class="my-10 md:my-12">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
    {steps.map((s) => (
      <div class="rounded-2xl p-4 md:p-5 text-center" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">
        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[12px] font-semibold" style="background: var(--color-teal-800); color: var(--color-cream-50)">{s.num}</span>
          <span class="text-[11px] uppercase tracking-[0.14em] font-semibold" style="color: var(--color-copper-600)">{s.duree}</span>
        </div>

        <svg viewBox="0 0 200 150" role="img" aria-label={s.titre} class="w-full max-w-[180px] mx-auto">
          <!-- Gencive (bande + festons) -->
          <rect x="26" y="22" width="148" height="22" rx="8" style="fill: var(--color-copper-300); stroke: var(--color-copper-500); stroke-width: 1.5" />
          <circle cx="60" cy="44" r="11" style="fill: var(--color-copper-300)" />
          <circle cx="100" cy="44" r="11" style="fill: var(--color-copper-300)" />
          <circle cx="140" cy="44" r="11" style="fill: var(--color-copper-300)" />

          {s.num === '1' && (
            <g>
              <!-- Dents nues -->
              {TEETH.map(d => <path d={d} style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2" stroke-linejoin="round" />)}
              <!-- Porte-empreinte qui descend -->
              <rect x="30" y="116" width="140" height="18" rx="9" style="fill: var(--color-teal-200); stroke: var(--color-teal-600); stroke-width: 1.8" />
              <line x1="100" y1="134" x2="100" y2="144" style="stroke: var(--color-teal-600); stroke-width: 3; stroke-linecap: round" />
              <line x1="100" y1="112" x2="100" y2="104" style="stroke: var(--color-copper-500); stroke-width: 2.4; stroke-linecap: round" />
              <polygon points="100,100 94,110 106,110" style="fill: var(--color-copper-500)" />
            </g>
          )}

          {s.num === '2' && (
            <g>
              <!-- Dents en fantôme (la gouttière est montrée seule) -->
              {TEETH.map(d => <path d={d} style="fill: none; stroke: var(--color-ink-300); stroke-width: 1.6; stroke-dasharray: 3 3" stroke-linejoin="round" />)}
              <!-- Gouttière -->
              <path d={TRAY} style="fill: var(--color-teal-200); fill-opacity: 0.5; stroke: var(--color-teal-600); stroke-width: 2" stroke-linejoin="round" />
              <!-- 3 gouttes de gel (forme goutte : pointe en haut, ronde en bas) -->
              {[
                { x: 60, y: 64 },
                { x: 100, y: 66 },
                { x: 140, y: 64 },
              ].map(p => (
                <path
                  d="M 0 -8.5 C 3.6 -2.6 5.2 0.4 5.2 2.8 A 5.2 5.2 0 1 1 -5.2 2.8 C -5.2 0.4 -3.6 -2.6 0 -8.5 Z"
                  transform={`translate(${p.x} ${p.y})`}
                  style="fill: var(--color-teal-600)"
                />
              ))}
              <!-- Seringue -->
              <rect x="138" y="124" width="44" height="11" rx="5" style="fill: var(--color-cream-100); stroke: var(--color-teal-700); stroke-width: 1.6" />
              <rect x="128" y="126.5" width="12" height="6" rx="2" style="fill: var(--color-teal-500)" />
              <line x1="182" y1="129.5" x2="192" y2="129.5" style="stroke: var(--color-teal-700); stroke-width: 3; stroke-linecap: round" />
            </g>
          )}

          {s.num === '3' && (
            <g>
              <!-- Dents -->
              {TEETH.map(d => <path d={d} style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2" stroke-linejoin="round" />)}
              <!-- Gouttière PORTÉE par-dessus les dents -->
              <path d={TRAY} style="fill: var(--color-teal-300); fill-opacity: 0.45; stroke: var(--color-teal-600); stroke-width: 2.2" stroke-linejoin="round" />
              <!-- Horloge 2h -->
              <circle cx="172" cy="124" r="17" style="fill: var(--color-cream-50); stroke: var(--color-copper-500); stroke-width: 2" />
              <line x1="172" y1="124" x2="172" y2="113" style="stroke: var(--color-copper-600); stroke-width: 2; stroke-linecap: round" />
              <line x1="172" y1="124" x2="181" y2="128" style="stroke: var(--color-copper-600); stroke-width: 2; stroke-linecap: round" />
            </g>
          )}
        </svg>

        <div class="mt-3 text-[16.5px] font-medium" style="font-family: var(--font-display)">{s.titre}</div>
        <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">{s.ligne}</p>
      </div>
    ))}
  </div>

  <figcaption class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12px] text-ink-500">
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-teal-200); border: 1px solid var(--color-teal-600)"></span> Gouttière sur mesure</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded-full" style="background: var(--color-teal-600)"></span> Gel de blanchiment</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-cream-100); border: 1px solid var(--color-ink-400)"></span> Dents</span>
  </figcaption>

</figure>
