---
import Layout from '../layouts/Layout.astro';
import SchemaRestaurations from './SchemaRestaurations.astro';

interface Section {
  id: string;
  titre: string;
  description: string;  // HTML autorisé (set:html — contrôlé)
  schema?: string;      // nom d'un schéma pédagogique à afficher après le texte ('restaurations', ...)
}

interface Props {
  pageTitle: string;       // <title> + meta
  pageDescription: string; // meta description
  eyebrow: string;         // "Famille" eyebrow
  h1: string;              // H1 SEO (mots-clés + ville)
  baseline: string;        // accroche tonale en sous-titre
  intro: string;           // paragraphe intro (HTML autorisé)
  sections: Section[];     // sections ancrées (TOC + contenu)
}

const { pageTitle, pageDescription, eyebrow, h1, baseline, intro, sections } = Astro.props;
---

<Layout title={pageTitle} description={pageDescription}>

  <!-- HERO famille -->
  <section class="container-wide pt-12 md:pt-20 pb-10 md:pb-14">
    <div class="max-w-3xl" data-reveal>
      <span class="eyebrow mb-5">{eyebrow}</span>
      <h1 class="text-[26px] md:text-[34px] leading-[1.2] tracking-tight mb-5" style="color: var(--color-teal-800)">
        {h1}
      </h1>
      <p class="text-[22px] md:text-[26px] leading-[1.25] mb-6" style="font-family: var(--font-display); color: var(--color-ink-900); font-weight: 500;">
        {baseline}
      </p>
      <p class="text-[16px] text-ink-700 leading-[1.75]" set:html={intro}></p>
    </div>
  </section>

  <!-- Layout 2 colonnes : TOC sticky + sections -->
  <section class="container-wide pb-24 md:pb-32">
    <div class="grid lg:grid-cols-[240px_1fr] gap-12 lg:gap-20">

      <!-- TOC sticky (desktop) -->
      <aside class="lg:sticky lg:top-28 lg:self-start hidden lg:block">
        <div class="text-[11px] uppercase tracking-[0.18em] font-semibold mb-4" style="color: var(--color-teal-700)">
          Sur cette page
        </div>
        <nav class="space-y-1.5">
          {sections.map(s => (
            <a href={`#${s.id}`} class="block text-[14px] py-1.5 transition-colors hover:text-teal-800" style="color: var(--color-ink-500)">
              {s.titre}
            </a>
          ))}
        </nav>
      </aside>

      <!-- Sections ancrées -->
      <div class="space-y-16 md:space-y-20">
        {sections.map((s, idx) => (
          <section id={s.id} class="scroll-mt-28" data-reveal data-reveal-delay={(idx * 80).toString()}>
            <h2 class="text-[26px] md:text-[32px] font-medium mb-5 leading-[1.2]" style="font-family: var(--font-display); color: var(--color-ink-900)">
              {s.titre}
            </h2>
            <div class="prose-soin" set:html={s.description}></div>
            {s.schema === 'restaurations' && <SchemaRestaurations />}
          </section>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA RDV -->
  <section class="container-wide pb-24 md:pb-32">
    <div class="card p-10 md:p-14 text-center" style="background: var(--color-cream-50); border-color: var(--color-cream-300)">
      <h3 class="text-[24px] md:text-[28px] font-medium mb-3" style="font-family: var(--font-display)">
        Une question sur l'un de ces soins ?
      </h3>
      <p class="text-[15px] text-ink-500 mb-7 max-w-xl mx-auto">
        Chaque consultation commence par une discussion : votre histoire, vos attentes, le plan de traitement écrit qui s'ensuit.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="https://www.doctolib.fr" target="_blank" rel="noopener" class="btn btn-primary">
          Prendre rendez-vous
        </a>
        <a href="/soins" class="btn btn-secondary">
          Voir tous les soins
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* TOC link actif au scroll (highlight via :target) */
  aside nav a:hover {
    color: var(--color-teal-800) !important;
    font-weight: 500;
  }
</style>
