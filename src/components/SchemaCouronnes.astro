---
/**
 * Les 3 familles de couronnes en coupe : CCM (armature métal),
 * céramo-céramique (translucide), zircone (monobloc).
 * Même dent taillée dessous — seule la coiffe change.
 */
const types = [
  {
    key: 'ccm',
    nom: 'Céramo-métallique (CCM)',
    ligne: "Une armature métallique sous la céramique : éprouvée et robuste.",
  },
  {
    key: 'ccc',
    nom: 'Céramo-céramique',
    ligne: "Tout céramique, sans métal : la translucidité la plus proche de la dent naturelle.",
  },
  {
    key: 'zircone',
    nom: 'Zircone',
    ligne: "Céramique haute résistance, monobloc — pour les fortes contraintes.",
  },
];

// Coquille de couronne (coupe) : contour externe + cavité interne épousant la dent taillée
const COURONNE = `M 68 150
  C 62 108 72 76 100 76
  C 128 76 138 108 132 150
  L 118 150 L 114 102
  C 112 94 88 94 86 102
  L 82 150 Z`;

// Dent taillée (moignon)
const MOIGNON = `M 82 150 L 86 102 C 88 94 112 94 114 102 L 118 150 Z`;

// Liseré d’armature métallique (CCM) : couche interne le long du moignon
const ARMATURE = `M 79 150 L 83.5 100 C 86 90 114 90 116.5 100 L 121 150`;
---

<figure class="my-10 md:my-12">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
    {types.map((t) => (
      <div class="rounded-2xl p-4 md:p-5 text-center" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">

        <svg viewBox="0 0 200 200" role="img" aria-label={t.nom} class="w-full max-w-[180px] mx-auto">
          <!-- Gencive -->
          <rect x="12" y="148" width="176" height="20" rx="6" style="fill: var(--color-copper-300); stroke: var(--color-copper-500); stroke-width: 1.5" />
          <!-- Racine (sous la gencive, en pointillés) -->
          <path d="M 84 166 C 86 182 92 190 100 190 C 108 190 114 182 116 166" style="fill: none; stroke: var(--color-ink-400); stroke-width: 1.5; stroke-dasharray: 4 3; opacity: 0.6" />

          <!-- Dent taillée -->
          <path d={MOIGNON} style="fill: var(--color-cream-300); stroke: var(--color-ink-400); stroke-width: 1.5; stroke-dasharray: 4 3" stroke-linejoin="round" />

          {t.key === 'ccm' && (
            <g>
              <path d={COURONNE} fill-rule="evenodd" style="fill: var(--color-teal-300); stroke: var(--color-teal-700); stroke-width: 1.6" stroke-linejoin="round" />
              <path d={ARMATURE} style="fill: none; stroke: var(--color-ink-700); stroke-width: 6" stroke-linecap="round" />
            </g>
          )}

          {t.key === 'ccc' && (
            <path d={COURONNE} fill-rule="evenodd" style="fill: var(--color-teal-300); fill-opacity: 0.5; stroke: var(--color-teal-600); stroke-width: 1.6" stroke-linejoin="round" />
          )}

          {t.key === 'zircone' && (
            <path d={COURONNE} fill-rule="evenodd" style="fill: var(--color-teal-500); stroke: var(--color-teal-700); stroke-width: 1.6" stroke-linejoin="round" />
          )}
        </svg>

        <div class="mt-3 text-[16px] md:text-[17px] font-medium" style="font-family: var(--font-display)">{t.nom}</div>
        <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">{t.ligne}</p>
      </div>
    ))}
  </div>

  <figcaption class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12px] text-ink-500">
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-teal-300); border: 1px solid var(--color-teal-600)"></span> Céramique</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-ink-700)"></span> Armature métallique</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-cream-300); border: 1px dashed var(--color-ink-400)"></span> Dent taillée</span>
  </figcaption>

</figure>
