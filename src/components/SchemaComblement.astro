---
/**
 * Préservation alvéolaire (comblement osseux après extraction) en 3 temps :
 * alvéole vide → comblement (os d’origine humaine) → os cicatrisé prêt pour l’implant.
 * Vocabulaire visuel commun : os = crème-200, gencive = cuivré-300,
 * matériau de comblement = teal-200 pointillé, implant = teal-400.
 */
const steps = [
  {
    num: '1',
    titre: "La dent vient d’être extraite",
    duree: 'Jour J',
    ligne: "L’alvéole — le logement de la racine — est vide. Sans comblement, l’os qui l’entoure fond en cicatrisant.",
  },
  {
    num: '2',
    titre: "L’alvéole est comblée",
    duree: 'Même séance',
    ligne: "Un matériau de comblement osseux, le plus souvent d’origine humaine, remplit l’alvéole et maintient le volume.",
  },
  {
    num: '3',
    titre: "Un implant posé sereinement",
    duree: 'Après cicatrisation',
    ligne: "L’os a cicatrisé en gardant son volume : l’implant se pose dans de bonnes conditions — sans greffe plus lourde, dans la majorité des cas.",
  },
];
---

<figure class="my-10 md:my-12">

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
    {steps.map((s) => (
      <div class="rounded-2xl p-4 md:p-5 text-center relative" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">

        <div class="flex items-center justify-center gap-2 mb-3">
          <span class="inline-flex items-center justify-center w-6 h-6 rounded-full text-[12px] font-semibold" style="background: var(--color-teal-800); color: var(--color-cream-50)">{s.num}</span>
          <span class="text-[11px] uppercase tracking-[0.14em] font-semibold" style="color: var(--color-copper-600)">{s.duree}</span>
        </div>

        <svg viewBox="0 0 200 200" role="img" aria-label={s.titre} class="w-full max-w-[180px] mx-auto">
          <!-- Os -->
          <rect x="12" y="112" width="176" height="76" rx="6" style="fill: var(--color-cream-200); stroke: var(--color-ink-300); stroke-width: 1.5" />
          <!-- Gencive -->
          <rect x="12" y="100" width="176" height="16" rx="6" style="fill: var(--color-copper-300); stroke: var(--color-copper-500); stroke-width: 1.5" />

          <!-- Dents voisines (contexte) -->
          <path d="M 26 104 C 25 78 28 62 36 58 C 44 54 54 54 60 58 C 68 62 71 78 70 104 Z" style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2" stroke-linejoin="round" />
          <path d="M 130 104 C 129 78 132 62 140 58 C 148 54 158 54 164 58 C 172 62 175 78 174 104 Z" style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2" stroke-linejoin="round" />

          {s.num === '1' && (
            <g>
              <!-- Alvéole vide (creux dans l’os) -->
              <path d="M 88 112 C 87 132 88 150 92 166 C 95 176 105 176 108 166 C 112 150 113 132 112 112 Z" style="fill: var(--color-cream-50); stroke: var(--color-ink-400); stroke-width: 1.8; stroke-dasharray: 4 3" stroke-linejoin="round" />
              <!-- Flèches de fonte osseuse (menace) -->
              <g style="stroke: var(--color-copper-500); stroke-width: 1.8" stroke-linecap="round">
                <path d="M 76 126 L 84 130" />
                <polygon points="87,131.5 80.5,131.5 84,126.5" style="fill: var(--color-copper-500); stroke: none" />
                <path d="M 124 126 L 116 130" />
                <polygon points="113,131.5 119.5,131.5 116,126.5" style="fill: var(--color-copper-500); stroke: none" />
              </g>
            </g>
          )}

          {s.num === '2' && (
            <g>
              <!-- Alvéole comblée : granules -->
              <path d="M 88 112 C 87 132 88 150 92 166 C 95 176 105 176 108 166 C 112 150 113 132 112 112 Z" style="fill: var(--color-teal-100); stroke: var(--color-teal-600); stroke-width: 1.8" stroke-linejoin="round" />
              <g style="fill: var(--color-teal-500)">
                <circle cx="96" cy="122" r="2.2" /><circle cx="104" cy="118" r="2.2" />
                <circle cx="100" cy="132" r="2.2" /><circle cx="93" cy="142" r="2.2" />
                <circle cx="106" cy="144" r="2.2" /><circle cx="98" cy="154" r="2.2" />
                <circle cx="103" cy="163" r="2.2" />
              </g>
            </g>
          )}

          {s.num === '3' && (
            <g>
              <!-- Os cicatrisé : plus d’alvéole, volume conservé — implant en place -->
              <path d="M 91 110 L 109 110 L 106 172 C 104 180 96 180 94 172 Z" style="fill: var(--color-teal-400); stroke: var(--color-teal-700); stroke-width: 1.6" stroke-linejoin="round" />
              <line x1="91" y1="124" x2="109" y2="124" style="stroke: var(--color-teal-700); stroke-width: 1.4" />
              <line x1="92" y1="138" x2="108" y2="138" style="stroke: var(--color-teal-700); stroke-width: 1.4" />
              <line x1="93" y1="152" x2="107" y2="152" style="stroke: var(--color-teal-700); stroke-width: 1.4" />
              <!-- Couronne -->
              <path d="M 84 102 C 82 76 87 60 100 60 C 113 60 118 76 116 102 Z" style="fill: var(--color-teal-400); stroke: var(--color-teal-700); stroke-width: 1.8" stroke-linejoin="round" />
            </g>
          )}
        </svg>

        <div class="mt-3 text-[16px] md:text-[18px] font-medium" style="font-family: var(--font-display)">{s.titre}</div>
        <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">{s.ligne}</p>
      </div>
    ))}
  </div>

  <figcaption class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12px] text-ink-500">
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-teal-100); border: 1px solid var(--color-teal-600)"></span> Matériau de comblement</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-teal-400); border: 1px solid var(--color-teal-700)"></span> Implant & couronne</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-cream-200); border: 1px solid var(--color-ink-300)"></span> Os</span>
  </figcaption>

</figure>
