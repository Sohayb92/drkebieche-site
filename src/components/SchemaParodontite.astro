---
/**
 * Parodontite : gencive saine → parodontite (poche + os détruit) → stabilisée après traitement.
 * Honnêteté médicale : l'os détruit ne repousse pas — la destruction est stoppée.
 */
const TOOTH_PATH = `M 52 148
  C 47 112 49 80 62 62
  C 72 47 85 45 93 57
  C 96 63 104 63 107 57
  C 115 45 128 47 138 62
  C 151 80 153 112 148 148
  C 147 172 142 196 133 208
  C 129 213 125 208 124 196
  C 123 182 121 170 117 162
  C 111 154 89 154 83 162
  C 79 170 77 182 76 196
  C 75 208 71 213 67 208
  C 58 196 53 172 52 148 Z`;
---

<figure class="my-10 md:my-12">

  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <pattern id="hatch-paro" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" style="fill: var(--color-cream-100)"></rect>
        <line x1="0" y1="0" x2="0" y2="6" style="stroke: var(--color-ink-300); stroke-width: 1.4"></line>
      </pattern>
    </defs>
  </svg>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">

    <!-- 1. Gencive saine -->
    <div class="rounded-2xl p-4 md:p-5 text-center" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">
      <svg viewBox="0 0 200 235" role="img" aria-label="Gencive saine" class="w-full max-w-[170px] mx-auto">
        <!-- Os haut (sain) -->
        <rect x="14" y="158" width="172" height="70" rx="6" style="fill: var(--color-cream-200); stroke: var(--color-ink-300); stroke-width: 1.5" />
        <!-- Gencive haute, au collet -->
        <rect x="14" y="142" width="172" height="20" rx="7" style="fill: var(--color-copper-300); stroke: var(--color-copper-500); stroke-width: 1.5" />
        <!-- Dent -->
        <path d={TOOTH_PATH} style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2.5" stroke-linejoin="round" />
      </svg>
      <div class="mt-3 text-[17px] font-medium" style="font-family: var(--font-display)">Gencive saine</div>
      <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">La gencive et l'os enserrent la dent au collet : un ancrage complet et stable.</p>
    </div>

    <!-- 2. Parodontite -->
    <div class="rounded-2xl p-4 md:p-5 text-center" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">
      <svg viewBox="0 0 200 235" role="img" aria-label="Parodontite" class="w-full max-w-[170px] mx-auto">
        <!-- Os détruit : niveau abaissé -->
        <rect x="14" y="190" width="172" height="38" rx="6" style="fill: var(--color-cream-200); stroke: var(--color-ink-300); stroke-width: 1.5" />
        <!-- Zone d'os détruit (hachures, entre ancien et nouveau niveau) -->
        <rect x="14" y="158" width="172" height="32" rx="6" fill="url(#hatch-paro)" style="stroke: var(--color-ink-300); stroke-width: 1; stroke-dasharray: 3 3" />
        <!-- Gencive abaissée et décollée (inflammation) -->
        <rect x="14" y="172" width="172" height="22" rx="7" style="fill: var(--color-copper-400); stroke: var(--color-copper-600); stroke-width: 1.8" />
        <!-- Dent -->
        <path d={TOOTH_PATH} style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2.5" stroke-linejoin="round" />
        <!-- Poche parodontale : espace sombre entre dent et gencive -->
        <path d="M 53 150 L 60 150 L 63 186 L 56 188 Z" style="fill: var(--color-ink-500); fill-opacity: 0.55" />
        <!-- Tartre sur la racine exposée -->
        <circle cx="57" cy="156" r="3.4" style="fill: var(--color-ink-400)" />
        <circle cx="62" cy="166" r="2.8" style="fill: var(--color-ink-400)" />
        <circle cx="58" cy="176" r="3" style="fill: var(--color-ink-400)" />
      </svg>
      <div class="mt-3 text-[17px] font-medium" style="font-family: var(--font-display)">Parodontite</div>
      <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">Une poche se creuse entre dent et gencive ; l'infection détruit l'os de soutien (zone hachurée).</p>
    </div>

    <!-- 3. Stabilisée -->
    <div class="rounded-2xl p-4 md:p-5 text-center" style="background: var(--color-cream-50); border: 1px solid var(--color-cream-300)">
      <svg viewBox="0 0 200 235" role="img" aria-label="Parodontite stabilisée" class="w-full max-w-[170px] mx-auto">
        <!-- Os : reste au niveau abaissé (il ne repousse pas) mais sain -->
        <rect x="14" y="190" width="172" height="38" rx="6" style="fill: var(--color-cream-200); stroke: var(--color-ink-300); stroke-width: 1.5" />
        <!-- Gencive réattachée, propre, ajustée au niveau osseux -->
        <rect x="14" y="174" width="172" height="20" rx="7" style="fill: var(--color-copper-300); stroke: var(--color-copper-500); stroke-width: 1.5" />
        <!-- Dent (racine partiellement visible mais propre) -->
        <path d={TOOTH_PATH} style="fill: var(--color-cream-100); stroke: var(--color-ink-400); stroke-width: 2.5" stroke-linejoin="round" />
        <!-- Coche de stabilité -->
        <circle cx="166" cy="36" r="16" style="fill: var(--color-teal-400); stroke: var(--color-teal-700); stroke-width: 1.6" />
        <polyline points="158,36 164,42 174,30" style="fill: none; stroke: var(--color-cream-50); stroke-width: 3" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div class="mt-3 text-[17px] font-medium" style="font-family: var(--font-display)">Stabilisée</div>
      <p class="mt-1.5 text-[12.5px] leading-[1.55] text-ink-500">Après traitement : plus de poche, plus d'infection. L'os perdu ne repousse pas, mais la destruction est <strong>stoppée</strong>.</p>
    </div>

  </div>

  <figcaption class="mt-5 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[12px] text-ink-500">
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-copper-300); border: 1px solid var(--color-copper-500)"></span> Gencive</span>
    <span class="inline-flex items-center gap-2"><span class="inline-block w-3.5 h-3.5 rounded" style="background: var(--color-cream-200); border: 1px solid var(--color-ink-300)"></span> Os de soutien</span>
    <span class="inline-flex items-center gap-2"><svg width="14" height="14" class="rounded overflow-hidden"><rect width="14" height="14" fill="url(#hatch-paro)" style="stroke: var(--color-ink-300); stroke-width: 1"/></svg> Os détruit par l'infection</span>
  </figcaption>

</figure>
