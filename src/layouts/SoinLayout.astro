---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  intro: string;
}

const { title, description, eyebrow, intro } = Astro.props;
---

<Layout title={`${title} — Cabinet Dr Sohaïb Kebieche, Colombes`} description={description}>

  <!-- HERO du soin -->
  <section class="container-wide pt-16 md:pt-24 pb-12 md:pb-20">
    <div class="max-w-3xl">
      <span class="eyebrow mb-5">{eyebrow}</span>
      <h1 class="text-[42px] md:text-[60px] leading-[1.08] tracking-tight mb-7">
        <Fragment set:html={title} />
      </h1>
      <p class="text-[18px] md:text-[20px] text-ink-700 leading-[1.6]">
        {intro}
      </p>
    </div>
  </section>

  <!-- Contenu MDX -->
  <article class="container-prose pb-20 md:pb-28 prose-soin">
    <slot />
  </article>

  <!-- CTA fin de page -->
  <section class="container-wide pb-24">
    <div class="rounded-3xl px-8 md:px-14 py-12 md:py-16 text-center" style="background: var(--color-teal-50); border: 1px solid var(--color-cream-300)">
      <h3 class="text-[28px] md:text-[34px] font-display tracking-tight mb-3">
        Une question, ou envie d'en discuter ?
      </h3>
      <p class="text-[15px] text-ink-700 mb-7 max-w-xl mx-auto">
        Le mieux pour évaluer votre situation reste un examen clinique. La consultation initiale est sans engagement.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="https://www.doctolib.fr" target="_blank" rel="noopener" class="btn btn-primary">
          Prendre rendez-vous
        </a>
        <a href="tel:+33142429469" class="btn btn-secondary">
          01 42 42 94 69
        </a>
      </div>
    </div>
  </section>

</Layout>
