---
// Polices auto-hébergées (conformité CNIL — aucune requête vers Google Fonts)
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css'; // vrai axe italique (logo « Sohaïb »)
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
}

const {
  title = "Dr Sohaïb Kebieche — Chirurgien-dentiste à Colombes",
  description = "Cabinet dentaire à Colombes (92). Implantologie, parodontologie, dentisterie adhésive moderne. Une dentisterie qui prend le temps de vous expliquer.",
  noindex = false,
  ogImage = "/og-image.jpg"
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://drkebieche.fr').toString();
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://drkebieche.fr').toString()} />
  <meta property="og:locale" content="fr_FR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Theme -->
  <meta name="theme-color" content="#F8F6F1" />

  <!-- Favicons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Structured data : LocalBusiness Dentist -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Dentist",
    "@id": "https://drkebieche.fr/#cabinet",
    "name": "Dr Sohaïb Kebieche",
    "alternateName": "Cabinet Dentaire La Cabane",
    "image": "https://drkebieche.fr/og-image.jpg",
    "telephone": "+33142429469",
    "email": "cabinetdentaire.lacabane@gmail.com",
    "sameAs": [
      "https://www.instagram.com/dr.kebieche",
      "https://www.doctolib.fr/dentiste/colombes/sohaib-kebieche-colombes",
      "https://g.page/r/CSAhN9X9DtepEBM"
    ],
    "hasMap": "https://g.page/r/CSAhN9X9DtepEBM",
    "url": "https://drkebieche.fr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "31 rue Félix Faure",
      "addressLocality": "Colombes",
      "postalCode": "92700",
      "addressCountry": "FR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 48.9148,
      "longitude": 2.2559
    },
    "openingHoursSpecification": [{
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "13:00"
    }, {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "15:00",
      "closes": "18:30"
    }]
  })} />
</head>
<body>
  <a href="#contenu" class="skip-link">Aller au contenu</a>
  <Header />
  <main id="contenu">
    <slot />
  </main>
  <Footer />

  <!-- Reveal au scroll (premium feel) — IntersectionObserver vanilla -->
  <script is:inline>
    (function() {
      const reveals = document.querySelectorAll('[data-reveal]');
      if (!reveals.length) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach(el => el.classList.add('visible'));
        return;
      }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const delay = parseInt(entry.target.dataset.revealDelay || '0', 10);
          if (delay > 0) entry.target.style.transitionDelay = delay + 'ms';
          entry.target.classList.add('visible');
          io.unobserve(entry.target);
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
      reveals.forEach(el => io.observe(el));
    })();
  </script>

  <!-- Schémas pédagogiques : dessin progressif au trait à l'entrée dans le viewport.
       Générique (tous les <figure svg>), état final identique au rendu statique,
       désactivé si prefers-reduced-motion. -->
  <script is:inline>
    (function() {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      const svgs = document.querySelectorAll('main figure svg');
      if (!svgs.length) return;

      const EASE = 'cubic-bezier(0.32, 0.72, 0, 1)';

      svgs.forEach((svg) => {
        const els = svg.querySelectorAll('path, line, polyline, polygon, rect, circle');
        els.forEach((el) => {
          const cs = getComputedStyle(el);
          el.dataset.fo = cs.fillOpacity;          // fill-opacity d'origine (0.5 translucide, etc.)
          el.style.fillOpacity = '0';
          if (cs.strokeDasharray === 'none' && el.getTotalLength) {
            try {
              const L = Math.ceil(el.getTotalLength());
              if (L > 0) {
                el.dataset.draw = L;
                el.style.strokeDasharray = String(L);
                el.style.strokeDashoffset = String(L);
              }
            } catch (e) { /* élément non géométrique : fondu seul */ }
          } else {
            el.dataset.op = cs.opacity;            // déjà en pointillés : fondu simple
            el.style.opacity = '0';
          }
        });
      });

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const els = entry.target.querySelectorAll('path, line, polyline, polygon, rect, circle');
          els.forEach((el, i) => {
            const d = Math.min(i * 55, 900);
            el.style.transition =
              'stroke-dashoffset 0.9s ' + EASE + ' ' + d + 'ms, ' +
              'fill-opacity 0.55s ease ' + (d + 250) + 'ms, ' +
              'opacity 0.55s ease ' + (d + 250) + 'ms';
            if (el.dataset.draw) el.style.strokeDashoffset = '0';
            if (el.dataset.op !== undefined) el.style.opacity = el.dataset.op;
            el.style.fillOpacity = el.dataset.fo || '1';
          });
          io.unobserve(entry.target);
        });
      }, { threshold: 0.35 });
      svgs.forEach((svg) => io.observe(svg));
    })();
  </script>
</body>
</html>
